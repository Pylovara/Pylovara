#!/usr/bin/env bash
# MCS Protein Handler v1.4 Aktiv
# Ruft passende Protein-Befehle auf, mit þ-Validierung und Checksum-Abgleich (Dateipfad)

source /Pylovara/MCSFramework/MCS.þ.Register

handle_protein_packet() {
    local packet="$1"
    local th_id="$2"
    local -a tokens=()
    tokenize_mcs "$packet" tokens

    [[ ${#tokens[@]} -eq 0 ]] && {
        echo "[MCS:Protein] Leeres Paket."
        return
    }

    local cmd="${tokens[0]//[\'\"]}"
    local args=("${tokens[@]:1}")

    if [[ -z "${PROTEIN_REG[$cmd]}" ]]; then
        echo "[MCS] Fehler: Unbekannter Befehl '$cmd' (Nicht im Protein-Register)."
        return 1
    fi

    echo "[MCS:Protein] erkannt → $cmd"

    local has_checksum=0
    local provided_checksum=""
    for arg in "${args[@]}"; do
        if [[ "$arg" =~ ^\{.*\}$ ]]; then
            parse_proton "$arg"
            if [[ "$arg" =~ ^\{Checksum\|þ([0-9a-f]{32})\}$ ]]; then
                has_checksum=1
                provided_checksum="${BASH_REMATCH[1]}"
            fi
        else
            echo "[MCS:Protein] Argument: $arg"
        fi
    done

    case "$cmd" in
        echo)
            echo "${args[*]}"
            ;;
        run)
            echo "[MCS] Starte ${args[*]}"
            ;;
        send)
            local target="${args[0]}"
            local proton_args=("${args[@]:1}")
            local file_checksum=$(echo -n "$target" | md5sum | cut -d' ' -f1 || echo "no_file")
            if [[ $has_checksum -eq 0 ]]; then
                echo "[MCS:Protein] Fehler: Keine Checksum für 'send' angegeben"
                return 1
            fi
            if [[ "$file_checksum" != "$provided_checksum" && "$file_checksum" != "no_file" ]]; then
                echo "[MCS:Protein] Fehler: Checksum stimmt nicht überein (erwartet: $file_checksum, erhalten: $provided_checksum)"
                return 1
            fi
            echo "[MCS:Protein] Sende $target mit þ$th_id (Checksum: $file_checksum)"
            for proton in "${proton_args[@]}"; do
                parse_proton "$proton"
            done
            cp -r "$target" /tmp/destination 2>/dev/null || echo "[MCS:Protein] cp fehlgeschlagen: Zielverzeichnis existiert nicht"
            ;;
        *)
            echo "[MCS] Unbekannter Proteinbefehl: $cmd"
            ;;
    esac
}


