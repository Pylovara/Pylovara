#!/usr/bin/env bash
# MCS Protein Handler v0.9 aktiv
# Ruft passende Protein-Befehle auf (demonstrativ noch)
# Neu : Register-Abfrage von MCS.Protein.Register in /Pylovara/MCSFramework/MCS.Protein.Register

handle_protein_packet() {
    local packet="$1"
    local -a tokens=()
    tokenize_mcs "$packet" tokens

    [[ ${#tokens[@]} -eq 0 ]] && {
        echo "[MCS:Protein] Leeres Paket."
        return
    }

    local cmd="${tokens[0]//[\'\"]}"
    local args=("${tokens[@]:1}")

    # NEU: Register-Abfrage
    if [[ -z "${PROTEIN_REG[$cmd]}" ]]; then
        echo "[MCS] Fehler: Unbekannter Befehl '$cmd' (Nicht im Protein-Register)."
        return 1
    fi
    # ENDE NEU

    echo "[MCS:Protein] erkannt → $cmd"

    for arg in "${args[@]}"; do
        if [[ "$arg" =~ ^\{.*\}$ ]]; then
            parse_proton "$arg"
        else
            echo "[MCS:Protein] Argument: $arg"
        fi
    done

    # Befehlsausführung (nur demonstrativ)
    case "$cmd" in
        echo) echo "${args[*]}" ;;
        run)  echo "[MCS] Starte ${args[*]}" ;;
        *)    echo "[MCS] Unbekannter Proteinbefehl: $cmd" ;;
    esac
}

