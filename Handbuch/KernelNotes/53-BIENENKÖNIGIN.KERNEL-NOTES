 ䷁    ䷆ Jump    ䷁    ䷆ Jump    ䷁    ䷆ Jump

 Jump = LEGT DIE SCHWERE DER BERECHNUNG FEST

 JUMP = ䷁ = ⠀⠀     =     01 -     99
 JUMP = ䷗ = ⠀⠀⠀    =    100 -    999
 JUMP = ䷖ = ⠀⠀⠀⠀   =   1000 -   9999
 JUMP = ䷇ = ⠀⠀⠀⠀⠀  =  10000 -  99999
 JUMP = ䷆ = ⠀⠀⠀⠀⠀⠀ = 100000 - 999999

 JUMP = ䷁ = KOPF-JUMP = BITBREITE 2
 JUMP = ䷗ = HECK-JUMP = BITBREITE 3
 JUMP = ䷖ = HECK-JUMP = BITBREITE 4
 JUMP = ䷇ = HECK-JUMP = BITBREITE 5
 JUMP = ䷆ = HECK-JUMP = BITBREITE 6
 ——————————————————————————————————
 JUMP = * = HECK-JUMP = SKALIERBAR 

 MATHEMATISCHE BITBREITE = KOPF-JUMP ~ HECK-JUMP
 DIMENSIONS-SKALIERUNG = JUMP

 SIE SKALIERT JE NACH EBENE DER DIMENSION, DIE 
 TRAGFÄHIGE HARDWARE DIE SIE BERECHNEN KANN .

 DER KOPF-JUMP = DEFINIERT DIE BASIS-BITBREITE 
 DER HECK-JUMP = SKALIERT DIE DIMENSION

 DIE KOMBINATION ERGIBT DIE GESAMTE RECHENKAPAZITÄT

 ䷁ <- SOLLTE SPÄTER MIT EINZELNEN STRICHEN IM 8 BRILLIAN PATTER ERSTELLT WERDEN
 ⠀ <- EQUIVALENT 

 ### BEISPIEL: 42 + 137

 # 1. BITBREITE FESTLEGEN
 ䷁ = 01 - 99  (8 Bit, reicht für 42)
 ䷗ = 100 - 999 (16 Bit, reicht für 137)

 # 2. ZAHLEN IN SEGMENTE
 42 = ⠄⠂
 137 = ⠁⠄⠠

 # 3. RECHNUNG
 ⠄⠂ + ⠁⠄⠠ = 179
 179 = ⠁⠠⣀

 ⠄⠂ + ⠁⠄⠠ = ⠁⠠⣀

 # 4. AUSGABE
 ䷗ (Bitbreite) + ⠁⠠⣀ (Wert) = 179
 
 VORTEIL : 

 ZAHLENBERECHNEN WIRD TRIVIAL PER SEGMENT 
 DEN SEGMENT SELBST IST DIE ZAHL. 

 DIMENSIONSBERECHNUNG : 

 ䷁ Jump       ䷁ Jump       ䷁ Jump   
 ⠀ 0          ⠁⠀ 10        ⠂⠀ 20    
    ,           ,            ,        
     ䷁ ䷗ Jump   ䷁ ䷗ Jump      ䷁ ䷗ Jump
     ⠁⠀⠀ 100    ⠂⠀⠀ 200       ⠄⠀⠀ 300

 ䷁,䷁䷗ = 0,100 | 10,200 | 20,300


 ANMERKUNG : 

 SOBALD ICH ALLES EINMAL IN DIE NEUE 0.3 TWS STRUKUTUR GEGOSSEN HABE 
 UND DANN IM NACHGANG FEHLERKOREKTUR BEI TYPOS USW DURCH KONSOLIDIERT HABE 
 UND DANACH DIE HONIG TROPFEN DURCH DEKLRAIERT HABE MIT MCS . 

 WERDE ICH DANN BEI SELBEN ATEMZUG ZU DEN DANN FOLGENDEN ARBEITERBIENEN 
 FÜR DEN FIRST BOOT IN ASSEMBLY, DIE BIENENKÖNNIGIN ALS PMMA INTEGRIEREN. 

 KEIN APL SCHWACHSIN MEHR DAS MEHR EINEM LABYRINTH ÄHNELT ALS ALLES ANDERE 
 SONDERN GLEICHZEITIG DIE EXTREM BESTIALISTISCHE RECHENEINHEIT, DIE JE 
 ALS MATHEMATISCHE TEIL - VERBAUT WURDE. 

 ICH BIN EXTREMS DAVON ÜBERZEUGT DAS DIE KRÖNUNG SELBST, BEI ALLEN ASPEKTEN 
 DER TWS UND MCS STRUKTUR - DAS „ FÜR IMMER “ ARGUMENT WIRD. 

