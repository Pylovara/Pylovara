@mcsplus-nr: 01 | ALU Brücke | Operator → ALU | MCSPLUS |
####################################################################
# Diese Brücke verbindet MCS-Plus Operatoren direkt mit der ALU
# Syntax:
#   RECHNER <Name> ¢! ... !¢
# ALU bekommt:
#   Eingänge → Input1 / Input2
#   Operator → PLUS / MINUS / MAL / GETEILT
#   Ausgang → Ergebnis
####################################################################

FUNKTION VERBINDE-RECHNER[RECHNER-NAME|1|2|AUSGABE]
¢!
    # Parser erkennt RECHNER-NAME
    # mappt 1 → ALU-Eingang A
    # mappt 2 → ALU-Eingang B
    # mappt AUSGABE → ALU-Ausgang
!¢

# Beispiel: PLUS
VERBINDE-RECHNER[EINGANG|1|PLUS|2][AUSGANG|ERGEBNIS]

# Beispiel: MINUS
VERBINDE-RECHNER[EINGANG|1|MINUS|2][AUSGANG|ERGEBNIS]

# Beispiel: MAL
VERBINDE-RECHNER[EINGANG|1|MAL|2][AUSGANG|ERGEBNIS]

# Beispiel: GETEILT
VERBINDE-RECHNER[EINGANG|1|GETEIL|2][AUSGANG|ERGEBNIS]
