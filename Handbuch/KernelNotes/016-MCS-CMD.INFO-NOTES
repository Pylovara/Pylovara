   - to = CallDirectory (zu Verzeichnis)
   - toip = Geht zu IP-Adresse
----------------------------------------------------------------------
 REGISTER-COMMAND-KLASSE = CMD-KOPIE
 FUNKTION = KOPIEROPERATIONEN
