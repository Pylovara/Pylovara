#!/usr/bin/env bash
# /Pylovara/Setup/MCS-Hyprland-Dotfiles/mcs-hyprland.fullinstall-core
# Alias: setup-desktop

MCS_CORE="/Pylovara/Setup/MCS-Hyprland-Dotfiles/hypr/hyprland.mcs-core"
HYPR_CONF="$HOME/.config/hypr/hyprland.conf"
CONFIG_DIR="$HOME/.config"

# --- FUNKTION: MCS-CORE IN HYPRLAND-CONF ÜBERSETZEN ---
# Dieser MCS-Client-Handler (Compiler) extrahiert die Informationen
# aus den Protein-Proton-Sequenzen und formatiert sie für Hyprland.
translate_mcs_hyprland_core() {
    local mcs_file="$1"
    local output_file="$2"

    echo "# GENERATED BY MCS-HYPRLAND CLIENT HANDLER (PoC)" > "$output_file"
    echo "# MCS-Core Source: $MCS_CORE" >> "$output_file"
    echo "" >> "$output_file"

    local current_section=""
    local group_name=""
    local token_pattern="»\[([^\]]+)\]«"

    while IFS= read -r line; do
        # --- 1. Kommentare, Transaktionen (¢| |¢) und Parallelität (¶=) ignorieren
        if [[ "$line" =~ ^\ *# ]] || [[ -z "${line// /}" ]] || [[ "$line" =~ ¢\| ]] || [[ "$line" =~ \|¢ ]] || [[ "$line" =~ ¶= ]]; then
            continue
        fi

        # --- 2. MCS-Protein erkennen ---
        if [[ "$line" =~ $token_pattern ]]; then
            local content="${BASH_REMATCH[1]}"
            # Simuliere den MCS-Tokenizer: trenne nach '|', ignoriere Trennzeichen in Protonen
            local tokens=$(echo "$content" | tr -d "[]{}'\"" | sed 's/|/ /g')
            local command=$(echo "$tokens" | awk '{print $1}')

            # --- ZIEL: HYPRLAND-SYNTAX ---

            # A) GRUNDLAGEN DEFINITIONEN (Variablen)
            # MCS: »['Define'|'Variable'|{Key|mainMod}|{Value|SUPER}|{Type|Key}]«
            if [[ "$command" == "Define" ]]; then
                local key=$(echo "$line" | grep -oP '\{Key\|\K[^}]*' | cut -d'}' -f1 | tr -d ' ')
                local value=$(echo "$line" | grep -oP '\{Value\|\K[^}]*' | cut -d'}' -f1 | tr -d ' ')
                echo "env = $key,$value" >> "$output_file"

            # B) SETTINGS (Input/General/Decoration)
            # MCS: »['setting'|'gaps_in'|{'value'|'5'}]«
            elif [[ "$command" == "setting" ]]; then
                local key=$(echo "$tokens" | awk '{print $2}')
                local value=$(echo "$line" | grep -oP '\{value\|\K[^}]*' | cut -d'}' -f1 | tr -d ' ')

                # Einfache Gruppenzuordnung (simuliert das Register)
                if [[ "$key" =~ ^(kb_|follow_|touchpad|sensitivity) ]]; then group_name="input";
                elif [[ "$key" =~ ^(gaps|border|col|layout) ]]; then group_name="general";
                else group_name="decoration"; fi

                # Sonderbehandlung für col.active_border, etc.
                if [[ "$key" =~ \. ]]; then
                    group_name=$(echo "$key" | cut -d'.' -f1) # Z.B. col.active_border -> col:active_border
                fi

                echo "$group_name:$key = $value" >> "$output_file"

            # C) STARTUP EXECUTION (exec-once)
            # MCS: »['exec'|'once'|{'Terminal'|'$terminal'}]«
            elif [[ "$command" == "exec" ]]; then
                # Extrahiert den reinen Befehl als den letzten Wert im Proton
                local exec_cmd=$(echo "$line" | grep -oP '\|¨?\K[^}\"\'\]]*' | tail -n1 | sed 's/¨//g' | sed 's/\}.*//')
                echo "exec-once = $exec_cmd" >> "$output_file"

            # D) KEYBINDS (bind)
            # MCS: »['bind'|'$mainMod,RETURN'|{'action'|'exec $terminal'}]«
            elif [[ "$command" == "bind" ]]; then
                local key_combo=$(echo "$tokens" | awk '{print $2}')
                local action=$(echo "$line" | grep -oP '\{action\|\K[^}]*' | cut -d'}' -f1) # Gesamte Aktion (z.B. exec $terminal)

                echo "bind = $key_combo, $action" >> "$output_file"
            fi
        fi

    done < "$mcs_file"

    echo "" >> "$output_file"
    echo "# END OF MCS-GENERATED CONFIGURATION (þID: $(uuidgen 2>/dev/null || date +%s%N | md5sum | cut -d' ' -f1))" >> "$output_file"
    echo "[MCS:CLIENT] Hyprland-Konfiguration erfolgreich übersetzt nach $output_file"
}

# --- FUNKTION: INSTALLATION ---
install_mcs_desktop() {
    echo "--- MCS-HYPRLAND DESKTOP INSTALLATION START: PoC v0.2 ---"

    # 1. Zielordner prüfen und erstellen
    mkdir -p "$CONFIG_DIR/hypr"
    mkdir -p "$CONFIG_DIR/waybar"
    mkdir -p "$CONFIG_DIR/kitty"

    echo "[MCS:FS] Konfigurationsordner gesichert."

    # 2. MCS-Core Übersetzung (Der entscheidende Schritt)
    echo "[MCS:Compiler] Starte MCS-Core Übersetzung: $MCS_CORE -> $HYPR_CONF"
    translate_mcs_hyprland_core "$MCS_CORE" "$HYPR_CONF"

    # 3. DOTFILES KOPIEREN (MCS-Client-Handler Simulation für andere Dotfiles)
    echo "[MCS:FS] Kopiere MCS-Client Dotfiles (simuliert)."

    # Normalerweise würden hier weitere MCS-Cores für Kitty/Waybar übersetzt.
    # Für den PoC werden minimale, funktionierende Konfigurationen geladen.

    # Kitty Config
    echo -e "font_family JetBrains Mono Nerd Font\nfont_size 12.0\n# MCS-Terminal-Client Ready" > "$CONFIG_DIR/kitty/kitty.conf"

    # Waybar Config
    echo -e '{"modules-left": ["hyprland/workspaces", "hyprland/window"], "modules-center": ["clock"], "modules-right": ["cpu", "memory", "battery", "tray"]}' > "$CONFIG_DIR/waybar/config"
    echo -e ".modules-left { background: #38b488; padding: 0 10px; border-radius: 0; }" > "$CONFIG_DIR/waybar/style.css"

    # 4. ABSCHLUSS
    echo ""
    echo "=== MCS-HYPRLAND DESKTOP INSTALLATION ERFOLGREICH ==="
    echo "Die Hyprland-Konfiguration wurde **nativ aus MCS-Syntax** übersetzt."
    echo "Das System ist bereit, als **erster MCS-Client** zu starten."
    echo ""
    echo "Aktionen:"
    echo "1. $HYPR_CONF wurde erstellt (native Hyprland-Konfig). ${key_combo}"
    echo "2. Terminal (Kitty) und Statusbar (Waybar) sind vorkonfiguriert."
    echo ""
    echo "NÄCHSTER SCHRITT: Starten Sie Hyprland, um das **MCS-Habitat** zu aktivieren."
    echo "   \$ **reboot** (oder ausloggen/wechseln zu Hyprland)"
}

# Führe die Installation aus
install_mcs_desktop
