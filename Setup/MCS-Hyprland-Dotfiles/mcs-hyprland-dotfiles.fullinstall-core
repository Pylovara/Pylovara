#!/bin/bash
# /Pylovara/Setup/MCS-Hyprland-Dotfiles/mcs-hyprland.fullinstall-core
# Pylovara Desktop Setup - Kopiert alle MCS-Hyprland-Dotfiles (V1.0 Komponenten)
# in den Benutzer-Home-Ordner.

PYLOVARA_SETUP_ROOT="/Pylovara/Setup/MCS-Hyprland-Dotfiles"
TARGET_CONFIG_DIR="$HOME/.config"

# --- 1. CONFIG-STRUKTUR PRÜFEN ---
if [[ ! -d "$PYLOVARA_SETUP_ROOT" ]]; then
    echo "❌ Fehler: Pylovara Setup-Ordner nicht gefunden: $PYLOVARA_SETUP_ROOT"
    return 1 2>/dev/null || exit 1
fi

echo "⚙️ Initialisiere Pylovara Desktop Umgebung (MCS-Hyprland-Dotfiles)..."

# --- 2. DYNAMISCHES KOPIEREN ALLER KOMPONENTEN ---
# Iteriere über alle Unterordner (waybar, kitty, rofi, etc.) im Setup-Verzeichnis.
for component_dir in "$PYLOVARA_SETUP_ROOT"/*; do
    component_name=$(/Pylovara/System/Shell/Vara/basename.vara "$component_dir")

    # Prüfen, ob es sich um ein Verzeichnis handelt
    if [[ -d "$component_dir" ]]; then
        echo "→ Kopiere $component_name Configs nach $TARGET_CONFIG_DIR/$component_name"

        # Erstelle den Zielordner im .config-Pfad
        /Pylovara/System/Shell/Vara/mkdir.vara -p "$TARGET_CONFIG_DIR/$component_name"

        # Kopiere Inhalt des Quellordners in den Zielordner
        /Pylovara/System/Shell/Vara/cp.vara -r "$component_dir/"* "$TARGET_CONFIG_DIR/$component_name/" 2>/dev/null || true
    fi
done

echo "✅ Pylovara Desktop Setup abgeschlossen. Konfigurationen bereitgestellt."
echo "      Neustart/Reboot terminal:$ reboot"
return 0 2>/dev/null || exit 0
