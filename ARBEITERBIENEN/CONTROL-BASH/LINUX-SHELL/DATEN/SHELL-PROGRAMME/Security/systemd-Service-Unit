# /PYLOVARA-SYSTEM/ARBEITERBIENEN/CONTROL-BASH/LINUX-SHELL/DATEN/SHELL-PROGRAMME/Security/pylowatchdog.conf
[Unit]
Description=Pylovara Rootbypass-Watcher (pylowatchd)
After=network.target

[Service]
Type=simple
ExecStart=/PYLOVARA-SYSTEM/ARBEITERBIENEN/CONTROL-BASH/LINUX-SHELL/DATEN/SHELL-PROGRAMME/Security/pylowatchd.sh
Restart=always
RestartSec=10
Nice=19
MemoryMax=50M
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=true
CapabilityBoundingSet=
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
ProtectKernelModules=yes
ReadWritePaths=/PYLOVARA-SYSTEM/PROBLEME

[Install]
WantedBy=multi-user.target
