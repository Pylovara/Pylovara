 BOXI KLASSE = MCS-CMD

 FUNKTION = HAUSEIGENER KOMMANDO BEFEHELE

 SYMBOLISCHE DEKLARATION = ~ ~

 SYMBOL IN WORTEN = TILDE INHALT TILDE

 INFO = STEUERT DAS EIGENE MCS-CMD-REGISTER AN

