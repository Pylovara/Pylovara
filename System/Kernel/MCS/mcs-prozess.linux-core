#include <iostream>
#include <fstream>
#include <string>
#include <vector>
#include <map>
#include <sstream>
#include <algorithm>
#include <functional>

/**
 * mcs_process.linux-core - MCS-Client-Handler (C++ 17)
 * Großvater - *.*-core: Übersetzt MCS-Syntax in Hyprland-Konfiguration
 * Erstellt: 2025-10-30 (Brutal-C-Syntax-Adaption, Stable Build)
 * Version 0.2
 * Architekt : Thomas Zimmermann
 * debug und code bereinigung : GPT-3/-4/-5
 */

// -------------------------------------------------------------
// HILFSFUNKTIONEN (MCS-Kernel-Analogon zu String-Werkzeugen)
// -------------------------------------------------------------

std::string mcs_trim(const std::string& str) {
    size_t first = str.find_first_not_of(" \t\n\r");
    if (std::string::npos == first) {
        return "";
    }
    size_t last = str.find_last_not_of(" \t\n\r");
    return str.substr(first, (last - first + 1));
}

void mcs_log(const std::string& msg) {
    std::ofstream log("/Pylovara/System/Logs/mcs-hyprland.log", std::ios::app);
    log << msg << std::endl;
}

// -------------------------------------------------------------
// 1. REGISTER DER MCS-MODULE (Die Konfigurationsbrücke)
// -------------------------------------------------------------
const std::map<std::string, std::string> MCS_MODULES = {
    {"MCS_SOURCE_FILE", "/Pylovara/Setup/MCS-Hyprland-Dotfiles/hyprland.mcs-core"},
    {"HYPRLAND_OUTPUT", "/Pylovara/Setup/MCS-Hyprland-Dotfiles/hypr/hyprland.conf"}
};

// -------------------------------------------------------------
// 2. MCS-KERNEL-SYMBOLE – Syntax v2.6
// -------------------------------------------------------------
namespace MCS_SYMBOLS {
    const std::string TRANSAKTION_START = "¢!";
    const std::string TRANSAKTION_ENDE = "!¢";
    const std::string AKTION_START = "»";
    const std::string AKTION_ENDE = "«";
    const std::string PROTEIN_ANFANG = "[";
    const std::string PROTEIN_ENDE = "]";
    const std::string PROTON_ANFANG = "{";
    const std::string PROTON_ENDE = "}";
    const std::string BLANKER_NENNER = "¨";  // Einfacher Separator
    const std::string MCS_HYPR_CMD = "’";    // Hyprland-Kernel-Befehle
    const std::string SYSTEM_CMD = "'";      // Systemweite Befehle
    const std::string PRINT_NENNER = R"(")"; // Für Textausgaben
    const std::string TRENNBEFEHL_NENNER = "|";
    const std::string KOMMENTAR = "#";
}

// -------------------------------------------------------------
// 3. KERN-LOGIK (Die MCS-Hyprland Übersetzungs-Transaktion)
// -------------------------------------------------------------
void mcs_to_hyprland(const std::string& mcs_content) {
    std::vector<std::string> hyprland_conf;
    std::stringstream mcs_stream(mcs_content);
    std::string line;

    std::cout << "[»] Initialisiere Modular-Kernel-Handler (C++-Core)..." << std::endl;

    while (std::getline(mcs_stream, line)) {
        line = mcs_trim(line);

        // Kommentare & Leere Zeilen überspringen
        if (line.empty() || line.rfind(MCS_SYMBOLS::KOMMENTAR, 0) == 0)
            continue;

        // 1. Transaktionsrahmen
        if (line.rfind(MCS_SYMBOLS::TRANSAKTION_START, 0) == 0) {
            hyprland_conf.push_back("\n# --- MCS-Transaktion-Start ---");
            continue;
        }
        if (line.find(MCS_SYMBOLS::TRANSAKTION_ENDE) != std::string::npos) {
            hyprland_conf.push_back("# --- MCS-Transaktion-Ende ---\n");
            continue;
        }

        // 2. Aktionen (Proteine) erkennen
        if (line.rfind(MCS_SYMBOLS::AKTION_START, 0) == 0 && line.find(MCS_SYMBOLS::AKTION_ENDE) != std::string::npos) {

            size_t start = line.find(MCS_SYMBOLS::AKTION_START) + MCS_SYMBOLS::AKTION_START.length();
            size_t end = line.rfind(MCS_SYMBOLS::AKTION_ENDE);
            if (end == std::string::npos || end < start)
                continue;

            std::string inner_content = mcs_trim(line.substr(start, end - start));

            // Befehl (CMD) extrahieren
            size_t cmd_end = inner_content.find('\'');
            if (cmd_end == std::string::npos)
                continue;

            std::string cmd = inner_content.substr(0, cmd_end);
            std::string proton_data = mcs_trim(inner_content.substr(cmd_end + 1));

            // -------------------------------------------------------------
            // BIND-BEFEHL
            // -------------------------------------------------------------
            if (cmd == "bind") {
                std::string modifiers, key, command;

                // Modifikatoren
                size_t mod_start = proton_data.find("{Mod|");
                if (mod_start != std::string::npos) {
                    size_t mod_end = proton_data.find('}', mod_start);
                    if (mod_end != std::string::npos && mod_end > mod_start + 5)
                        modifiers = proton_data.substr(mod_start + 5, mod_end - (mod_start + 5));
                }

                // Key
                size_t key_start = proton_data.find("{Key|");
                if (key_start != std::string::npos) {
                    size_t key_end = proton_data.find('}', key_start);
                    if (key_end != std::string::npos && key_end > key_start + 5)
                        key = proton_data.substr(key_start + 5, key_end - (key_start + 5));
                }

                // Command: Reihenfolge nach Priorität (MCS, System, Blanker)
                size_t pos, endpos;
                if ((pos = proton_data.find(MCS_SYMBOLS::MCS_HYPR_CMD)) != std::string::npos) {
                    endpos = proton_data.find(MCS_SYMBOLS::MCS_HYPR_CMD, pos + 1);
                    if (endpos != std::string::npos)
                        command = proton_data.substr(pos + 1, endpos - pos - 1);
                }
                else if ((pos = proton_data.find(MCS_SYMBOLS::SYSTEM_CMD)) != std::string::npos) {
                    endpos = proton_data.find(MCS_SYMBOLS::SYSTEM_CMD, pos + 1);
                    if (endpos != std::string::npos)
                        command = proton_data.substr(pos + 1, endpos - pos - 1);
                }
                else if ((pos = proton_data.find(MCS_SYMBOLS::BLANKER_NENNER)) != std::string::npos) {
                    endpos = proton_data.find(MCS_SYMBOLS::BLANKER_NENNER, pos + 1);
                    if (endpos != std::string::npos)
                        command = proton_data.substr(pos + 1, endpos - pos - 1);
                }

                if (!modifiers.empty() && !key.empty() && !command.empty()) {
                    hyprland_conf.push_back("bind = " + modifiers + ", " + key + ", exec, " + command);
                    continue;
                } else {
                    mcs_log("[¢!] WARN: Ungültiger bind-Befehl erkannt.");
                }
            }

            // -------------------------------------------------------------
            // EXEC-BEFEHL
            // -------------------------------------------------------------
            else if (cmd == "exec") {
                size_t cmd_start = proton_data.find(MCS_SYMBOLS::BLANKER_NENNER);
                if (cmd_start != std::string::npos) {
                    size_t cmd_end = proton_data.find(MCS_SYMBOLS::BLANKER_NENNER, cmd_start + 1);
                    if (cmd_end != std::string::npos && cmd_end > cmd_start + 1) {
                        std::string command = proton_data.substr(cmd_start + 1, cmd_end - cmd_start - 1);
                        hyprland_conf.push_back("exec = " + command);
                        continue;
                    }
                }
            }

            // -------------------------------------------------------------
            // UNBEKANNTE AKTION
            // -------------------------------------------------------------
            else {
                std::cerr << "[¢!] WARN: Unbekannte MCS-Aktion im Hyprland-Kontext übersprungen: " << cmd << std::endl;
                mcs_log("[¢!] WARN: Unbekannte MCS-Aktion übersprungen: " + cmd);
            }
        }
    }

    // -------------------------------------------------------------
    // EXPORT
    // -------------------------------------------------------------
    const std::string output_path = MCS_MODULES.at("HYPRLAND_OUTPUT");
    std::ofstream outfile(output_path);

    if (outfile.is_open()) {
        for (const std::string& conf_line : hyprland_conf)
            outfile << conf_line << "\n";
        outfile.close();

        std::cout << "[«] MCS-Transaktion abgeschlossen. Native Konfiguration erstellt: "
        << output_path << std::endl;
        std::cout << "[«] Status: " << hyprland_conf.size() << " Zeilen Hyprland-Konfig generiert." << std::endl;
    } else {
        std::cerr << "[¢!] FEHLER: Konnte Hyprland-Ausgabedatei nicht öffnen: " << output_path << std::endl;
        mcs_log("[¢!] FEHLER: Ausgabe konnte nicht geöffnet werden.");
    }
}

// -------------------------------------------------------------
// 4. LADEFUNKTION DES MCS-KERNELS
// -------------------------------------------------------------
std::string load_mcs_file(const std::string& filepath) {
    std::ifstream infile(filepath);
    if (!infile.is_open()) {
        std::cerr << "[¢!] FEHLER: Quelldatei nicht gefunden: " << filepath << std::endl;
        mcs_log("[¢!] FEHLER: Quelldatei nicht gefunden: " + filepath);
        return "";
    }
    std::string content((std::istreambuf_iterator<char>(infile)), std::istreambuf_iterator<char>());
    std::cout << "[»] Lade MCS-Datei: " << filepath << std::endl;
    return content;
}

// -------------------------------------------------------------
// 5. START DES MCS-KERNELS
// -------------------------------------------------------------
int main() {
    std::string mcs_data = load_mcs_file(MCS_MODULES.at("MCS_SOURCE_FILE"));
    if (!mcs_data.empty())
        mcs_to_hyprland(mcs_data);
    return 0;
}
