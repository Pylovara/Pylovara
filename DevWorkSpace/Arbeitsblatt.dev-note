####################################################################

Proof of Conzept

um MCS als Framework einsatzbereit zu bekommen

ANTLR grammar MCS;

// Einstieg: jede MCS-Transaktion ist zwischen ¢| ... |¢
transaction
    : START content* END
    ;

content
    : protein
    | proton
    | warp
    | feed
    | logic
    | COMMENT
    ;

// Proteine » ... «
protein
    : '»' proteinContent+ '«'
    ;

proteinContent
    : STRING
    | COMMAND
    | NUMBER
    | argument
    | proton
    ;

// Protonen { ... }
proton
    : '{' ID '|' VALUE ( '|' VALUE )* '}'
    ;

// Warp øLang| ... ø
warp
    : 'ø' ID '|' .*? 'ø'
    ;

// Feed = (zahl)
feed
    : '=' '()' '(' NUMBER ')'
    ;

// Argumente «« + - * %
argument
    : '««' (PLUS | MINUS | MULT | DIV | PERCENT) NUMBER?
    ;

// Logik / Operatoren
logic
    : '¶'           // IF
    | '¶¶'          // ELSE
    | '¶='          // Parallel
    | ';;'          // Parallel Transport
    | '⊕'           // Sync-Timer
    | '°' ID        // WennNicht
    | '^' ID        // Fehler
    ;

// Tokens
START  : '¢|';
END    : '|¢';
COMMENT: '#' ~[\r\n]* -> skip;

STRING : '"' (~["\r\n])* '"';
COMMAND: '\'' (~['\r\n])* '\'';
ID     : [a-zA-Z_][a-zA-Z0-9_]*;
VALUE  : [a-zA-Z0-9._:/-]+;
NUMBER : [0-9]+;

PLUS   : '+';
MINUS  : '-';
MULT   : '·' | '*';
DIV    : ':';
PERCENT: '%';

WS     : [ \t\r\n]+ -> skip;


test code ;

¢|
  »['MotorA'|{Watt|200}|{Volt|12}]« = §(1)Displey
  ¶=
  »[{Temp|25}$SensorX]«
  ⊕
  øC|
    #include <stdio.h>
    int main() { return 0; }
  ø = §gcc
|¢

Parser ausgabe verkürzt beispiel ;

als MCS 2.1 eingeführte Muster von ¢|transaction|¢

transaction
 ├─ protein
 │   ├─ STRING "MotorA"
 │   ├─ proton {Watt|200}
 │   └─ proton {Volt|12}
 ├─ feed §(1)
 ├─ logic ¶=
 ├─ protein
 │   └─ proton {Temp|25}
 ├─ logic ⊕
 ├─ warp (C code …)
 └─ feed §gcc
