#!/usr/bin/env bash
# Modul: protein-packet.parser-core
# Version: 1.9
# Autor: pylovara.ai / AI-Patch
# Zweck: Analysiert und zerlegt die gesamte MCS 1.9 Transaktionskette (¢|...|¢).

INPUT="$1"

# Funktion zum Parsen des inneren Proton-Paares {Typ|Wert}
# Nimmt den Inhalt eines Proton-Blocks und zerlegt ihn.
parse_proton_pair() {
    local proton_content="$1"

    # Entferne geschweifte Klammern { und }
    proton_content="${proton_content#\{}"
    proton_content="${proton_content%\}}"

    local key="${proton_content%%|*}"
    local val="${proton_content#*|}"

    # Ausgabe des strukturierten Datenpaares
    if [[ "$key" == "$val" ]]; then
        printf "│              [Rohdaten] : %s\n" "$proton_content"
    else
        printf "│              {%s} : %s\n" "$key" "$val"
    fi
}

# Funktion zum Parsen eines Proteinpackets »[...]«
# Sucht nach Protonen {Typ|Wert} innerhalb der eckigen Klammern.
parse_proteinpacket() {
    local packet="$1"

    # 1. Entferne äußere Klammern »[...]«
    local content="${packet#*»}"
    content="${content%«*}"

    echo "┌── Protein-Paket (»...«) ────────"

    # 2. Extrahieren aller Proton-Paare {Typ|Wert} mit Regex
    local regex_protons='\{[^}]+\}'
    local protons=$(grep -oE "$regex_protons" <<< "$content")

    if [[ -z "$protons" ]]; then
        # Falls keine strukturierten Protonen gefunden, gib den Inhalt roh aus
        echo "│              [Payload] : $content (Roh)"
    else
        echo "│              [Payload] : Strukturierte Protonen gefunden"
        while IFS= read -r proton; do
            [[ -z "$proton" ]] && continue
            parse_proton_pair "$proton"
        done <<< "$protons"
    fi

    echo "└─────────────────────────────────"
}

# Funktion zur Analyse der gesamten Transaktion
analyze_transaction() {
    local transaction="$1"

    # 1. Entferne Transaktions-Klammern ¢| und |¢
    local chain="${transaction#¢|}"
    chain="${chain%|¢}"

    echo "=========================================================="
    echo "== MCS 1.9 Transaktionskette (¢|...|¢) gestartet"

    # 2. Tokenisierung: Extrahieren aller Aktionen und Flow-Symbole

    # a) Trennen der Aktionen (»[...]«) von den Flow-Symbolen (⊕, *, ¶, etc.)
    local actions=$(grep -oP '»\[[^\]]+\]«' <<< "$chain")

    # b) Reduziere die Kette auf die Steuerungs-Symbole für die Übersicht
    local operators=$(sed -E 's/»\[[^\]]+\]«/###ACTION###/g' <<< "$chain" | tr -d '[:space:]')

    echo "----------------------------------------------------------"
    echo "[META-KETTE (Symbolisch)] $operators"
    echo "----------------------------------------------------------"

    local step=1
    while IFS= read -r action; do
        [[ -z "$action" ]] && continue
        echo "[[ AKTION BLOCK $step ]]"

        # Parsen des Protein-Blocks
        parse_proteinpacket "$action"

        step=$((step + 1))
    done <<< "$actions"

    echo "== MCS 1.9 Transaktionskette beendet"
    echo "=========================================================="
}


# Extrahieren der vollen ¢|...|¢ Transaktion aus der Eingabe
extract_transaction() {
    local data="$1"
    # Sucht die volle Transaktion in der Datei
    grep -oP '¢\|\K.*(?=\|¢)' <<< "$data" | while read -r raw_chain; do
        analyze_transaction "¢|$raw_chain|¢"
    done
}

### Einstiegspunkt
if [[ -n "$INPUT" && -f "$INPUT" ]]; then
    extract_transaction "$(cat "$INPUT")"
elif [[ -n "$INPUT" && ! -f "$INPUT" && "$INPUT" =~ ^¢\|.*\|¢$ ]]; then
    # Direkte Eingabe einer vollen Kette (z.B. aus der Kommandozeile)
    analyze_transaction "$INPUT"
else
    echo "----------------------------------------------------------"
    echo "### Modul: protein-packet.parser-core (V1.9) ###"
    echo "⚠ Keine Datei übergeben oder ungültige MCS 1.9 Kette erwartet."
    echo "🛈 Aufruf: $0 [Datei] ODER $0 '¢|...|¢'"
    echo ""
    echo "BEISPIEL für direkte Eingabe:"
    echo "$0 '¢| Init * exec »[{Target|Modul}]« ⊕ »[§{Befehl|live-patch}]« |¢'"
    echo "----------------------------------------------------------"
fi
