### ==== ##### == # === ### ==REPO-VORWORT= ### === # == ##### === ###
#
# DAS REPO SPEZIALISIERT SICH AUF DIE TERMINAL NUTZUNG UND BAUT IN 
# DIESEM ASPEKT AUF BASH AUF.
#
# DAS PYLOVARA-SYSTEM SELBST, WÄCHST AUS DEM BEREICH :
# -> $ to /Pylovara/Handbuch/
#
### ==== ##### == # == LINUX INSTALLATIONSPROZESS = # == ##### === ###

git clone https://github.com/Pylovara/Pylovara.git
cd Pylovara/Setup/Pylovara-System/
sudo ./full.install-core

### ==== ##### == # === # LINUX DERIVATE 86_64# === # == ##### === ###
# Alle Linux Derivate mit BASH-SHELL werden Unterstützt
# Alle Homebrew BASH-Shell werden Unterstützt
# Zsh wird nicht Unterstützt
# Termux wird strickt abgelehnt, weil Android Closed Bootloader
# Politik - Installation auf eigene Faust.
# ARM basierte Systeme werden nicht unterstützt - eigene Verantwortung.
### ==== ##### == # == INSTALLATIONSINFORMATION === # == ##### === ###
# Hier wird mit Arch + Bash + Kitty First gearbeitet,
# bei Problemen auf andere Derivate Befehle einzelnd eingeben .
# Funktioniert auch über Homebrew oder WSL , Primär Linux-Zen + Bash
# Besonderheit: Pylovara ab Linuxkernel install direkt im tty möglich
# und bringt volle hyprland desktops von hause mit von ausgewählten
# seriösen Delevoper.
### ==== ##### == # === ### = UPDATE MANUAL ### === # == ##### === ###

cd Pylovara/Setup/Pylovara-System/
sudo ./pylovara.updater-needle

### ==== ##### == # === # UPDATE INFORMATION ## === # == ##### === ###
# - sucht alte installationen /Pylovara/ ~/Pylovara
# - löscht sie rekursiv & sauber
# - klont das repo nach /tmp/pylovara-latest
# - kopiert das geklonte repo nach /Pylovara/
# - lässt wrapper außenvor weil schon gesetzt
# - entfernt /tmp/pylovara-latest wieder
# - funktioniert nur mit = sudo ./pylovara.updater-needle
# - einführung der wahrheiten logistik
# wenns nicht klappt =
#       - einfach zip laden
#       - entpacken
#       - /Pylovara/ ordner ersetzen im Root
#       - fertig
