###====================================|====================================###
### PYLOVARA-CONFIG   = LINUX-BASH-CONTROL
### ALLE CONF SOURCEN - KOMPLETTE KONTROLLE
### QUELLE  = /PYLOVARA-SYSTEM/ARBEITERBIENEN/CONTROL-BASH/CONTROL.PV-CONF
###====================================|====================================###
### HAUPT-PFAD 
export PV_DIR="/PYLOVARA-SYSTEM/"

### CONTROL-PFAD
MASTER_DIR="/PYLOVARA-SYSTEM/ARBEITERBIENEN/CONTROL-BASH/"

### SHELL-PROGRAMME
SHELL_DIR="/PYLOVARA-SYSTEM/ARBEITERBIENEN/CONTROL-BASH/LINUX-SHELL/DATEN/SHELL-PROGRAMME/"

### DatenTypen !!
# ! source "/Pylovara/System/Module/Pylovara/Logic/pylovara.ini-parser-logic"
# ! parse_conf "$MASTER_DIR/datatypes.conf"

###====================================|====================================###
### MASTER INPUT 

source "$MASTER_DIR/SHELL.CONF"

###====================================|====================================###
### ALIAS SEKTOR 

alias dna='/PYLOVARA-SYSTEM/ARBEITERBIENEN/CONTROL-BASH/LINUX-SHELL/DATEN/SHELL-PROGRAMME/DNA/dna.shell-dna'

###====================================|====================================###
### ALIAS SEKTOR 

to() {
    source "$SHELL_DIR/DNA/to.to-dna"
    to "$@"
}
helpme() {
    source "$SHELL_DIR/DNA/helpme.cut-dna" "$@"
}
kernel() {
    source "$SHELL_DIR/DNA/kernel.cut-dna" "$@"
}
waben() {
    source "$SHELL_DIR/DNA/waben.cut-dna" "$@"
}
mcs() {
    source "$SHELL_DIR/DNA/mcs.cut-dna" "$@"
}
vision() {
    source "$SHELL_DIR/DNA/vision.cut-dna" "$@"
}
p() {
    source "$SHELL_DIR/DNA/p.tree-dna" "$@"
}
callme() {
    source "$SHELL_DIR/DNA/callme.basename-dna"
    callme "$@"
}

###====================================|====================================###