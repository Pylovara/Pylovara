typedef enum {
    WAHR_NONE = 0,
    WAHR_IF,          // ¶
    WAHR_ELSE,        // ¶¶
    WAHR_WHEN_NOT,    // °
    WAHR_MUST,        // !
    WAHR_ON_ERROR,    // …
    WAHR_PARALLEL_RUN,      // ¶=
    WAHR_PARALLEL_TRANSPORT // ;;
} mcs_wahrheit_t;

// 🔹 Nur Deklarationen — KEINE Implementierung!
