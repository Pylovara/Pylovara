### ==== ##### == # === ### =============== ### === # == ##### === ###

DATEITYPEN-IDENTIFIKATION-ORGANISATOR-AUSFÜRHUNGSKLASSE § DATIK-KLASSE-DATIH-KLASSE-DATIU-KLASSE-NEEDLE

TYP-KENNUNG = 0x0100
SYMBOLISCHE ERKENNUNG = -NEEDLE
BEFEHLSZEILEN-EINGABE = »[~find needle for "GPU-X-2026"~]«
FUNKTION = HARDWARE-NAHE STEUERDATEIEN (.SYS, .KO, .DLL)
INFO = DIRECT HARDWARE-BINDUNG – KERNELNÄCHSTE EBENE
SPEICHERLAYOUT:
  0x00–0x03: "PYLO"
  0x04–0x05: 0x0100
  0x06–0x07: NEEDLE-ID
  0x08–0x0F: TIMESTAMP
  0x10–0x1F: OWNER-SIGNATUR (þþ)
  0x20–0xFF: HARDWARE-PARAMETER

