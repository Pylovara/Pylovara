danach : þ-Generator → unveränderliche Identität für jede KI.

Phase 1 bleibt ohne then_branch/else_branch, stattdessen:

// In mcs_run_transaktion():
for (int i = 0; i < t->operator_count; i++) {
    mcs_operator_t* op = t->operators[i];
    if (op->type == MCS_OP_WHEN_NOT && t->protein_count >= 2) {
        mcs_truth_t eval = mcs_evaluate_operator(op);
        if (eval == MCS_TRUE) {
            // Führe erstes Protein als THEN aus
            if (t->proteine[0]) mcs_run_protein(t->proteine[0]);
        } else if (eval == MCS_FALSE) {
            // Führe zweites Protein als ELSE aus
            if (t->proteine[1]) mcs_run_protein(t->proteine[1]);
        }
    } else if ((op->type == MCS_OP_WHEN_LT || op->type == MCS_OP_WHEN_GT)
               && op->data.cmp.left_id >= 0 && op->data.cmp.right_id >= 0) {
        mcs_truth_t eval = mcs_evaluate_operator(op);
        if (eval == MCS_TRUE && t->protein_count >= 2) {
            if (t->proteine[0]) mcs_run_protein(t->proteine[0]);
        } else if (eval == MCS_FALSE && t->protein_count >= 2) {
            if (t->proteine[1]) mcs_run_protein(t->proteine[1]);
        }
    } else if (op->type == MCS_OP_DATA_RESIDUE && op->data.residue_id >= 0) {
        mcs_feed_clear(op->data.residue_id);  // ✅ sofort!
    }
}

MVP: op->then_branch = t->proteine[t->protein_count - 2]
→ op->else_branch = t->proteine[t->protein_count - 1]
→ Erst danach kommen mcs_parse_next_protein() + mcs_lexer_peek
