/* * MCS-FAMILIENMODELL (ROLLEN-DEFINITION)
 * Organisiert die Vererbungsstränge und Zugriffsrechte.
 */

// *.core / *.lcore / *.vcore
// INSTANZ: Großvater (Ausführender Teil)
// FUNKTION: Hauptsteuerung, Hardware-nah (Low-Level) oder Visuell.
#define MCS_TYPE_CORE    "*.core"

// *.magic
// INSTANZ: Großmutter (Umschalter)
// FUNKTION: Konfigurationsbrücke und Logik-Umschaltung.
#define MCS_TYPE_MAGIC   "*.magic"

// *.node
// INSTANZ: Vater (Hauptcontroller)
// FUNKTION: Koordiniert Sub-Prozesse und Datenfluss.
#define MCS_TYPE_NODE    "*.node"

// *.nano
// INSTANZ: Mutter (Substrukturmanager)
// FUNKTION: Verwaltung der untergeordneten Logik-Einheiten.
#define MCS_TYPE_NANO    "*.nano"

// *.micro
// INSTANZ: Tochter (Mikrosteuerung)
// FUNKTION: Schnittstelle für Sub-Sprachen (HTML, JS, SQL).
#define MCS_TYPE_MICRO   "*.micro"

// *.cache
// INSTANZ: Temp-Speicher
// FUNKTION: Zwischenspeicherung flüchtiger Transaktionsdaten.
#define MCS_TYPE_CACHE   "*.cache"

// *.needles
// INSTANZ: Hardwarebindung (Treiber)
// FUNKTION: Physisches Anzapfen der Hardware-Register (.sys/.dll).
#define MCS_TYPE_NEEDLE  "*.needles"

// *.kernel
// INSTANZ: MCS-Framework
// FUNKTION: Interne Kernel-Logik und C-Compiler-Brücke.
#define MCS_TYPE_KERNEL  "*.kernel"

/* * SECURITY-ADDON (PP-GENERATOR)
 */

// *.redflag-notes
// INSTANZ: Sicherheits-Bericht
// FUNKTION: Isolierter Log-Datentyp für fehlgeschlagene þ-Validierung.
#define MCS_TYPE_REDFLAG "*.redflag-notes"

/* * LOGIK-STRUKTUR (KOPF-STRANG-PRINZIP)
 */

typedef struct {
    char extension[16];     /* Dateiendung (Typ-Erkennung) */
    char family_role[16];   /* Rolle im Familienmodell */
    uint8_t access_lvl;     /* Vererbungs-Ebene (1-5) */
} mcs_file_logic_t;

/* * SPEZIAL-FUNKTION: SYNC-TIMER ⊕
 * Macht Datensätze zu ein-/aushängbaren Puzzlestücken.
 */
#define MCS_SYNC_PUZZLE  "⊕"

####################################################################
@dev-notes | KERNEL-88 | ENDE DER DATEITYPEN
####################################################################
