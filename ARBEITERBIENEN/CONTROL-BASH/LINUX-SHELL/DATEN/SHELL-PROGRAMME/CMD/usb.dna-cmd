# usb.dna-cmd
# Zeigt USB-Geräteinformationen (via lsusb)

DNA_EXEC() {
    if ! command -v /PYLOVARA-SYSTEM/ARBEITERBIENEN/CONTROL-BASH/LINUX-SHELL/DATEN/SHELL-PROGRAMME/VARA/lsusb.vara >/dev/null 2>&1; then
        echo "❌ Fehler: 'lsusb' ist nicht installiert (z.B. 'pacman -S usbutils')" >&2
        return 1
    fi
    echo "🧬 DNA usb: Zeige USB-Geräte (lsusb)"
    /PYLOVARA-SYSTEM/ARBEITERBIENEN/CONTROL-BASH/LINUX-SHELL/DATEN/SHELL-PROGRAMME/VARA/lsusb.vara | /PYLOVARA-SYSTEM/ARBEITERBIENEN/CONTROL-BASH/LINUX-SHELL/DATEN/SHELL-PROGRAMME/VARA/less.vara
}
