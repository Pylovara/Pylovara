############################################
VERBINDUNGEN 

SBSK = SCHABLONEN BAUSTEINSCHALTUNGSKREISLAUF 
       FÜR MASTERWÖRTER 

VBSK = VARIABLER BAUSTEINSCHALTUNGSKREISLAUF 
       FÜR COMBOWABEN ÜBERSCHNEIDUNGEN 

RBSK = KERNWABEN BAUSTEINSCHALTUNGSKREISLAUF 
       RELATIVERPFAD 
############################################
ABLAUF-FOLGE

HAUPTWABE   = KEINE SYMBOL AXIOM | DAFÜR MORPHIC ID = MORPHIC-ID
STARTWABE   = GRUNDSYMBOL

FOLGEWABEN  = SYMBOL PLUS WEITERE OPTIONEN 

ENDWABE     = GESAMMTE SYMBOLE ZUSAMMENFÜHRUNG
LINKENDWABE = GESAMT SYMBOLE ZUSAMMENFÜHRUNG
############################################
EINSATZ GEBIET 

DATENTYPWABE = DATENTYP ANSTEUERUNG ZU KERNWABEN 
--------------------------------------------
KERNWABE   = KERNANSTEUERUNG ZU HAUPTWABEN (PROGRAMMIERUNGEN)
HAUPTWABE  = PROGRAMMIERUNG HEADER PER NAMENSPRÄFIX 
STARWABE   = ANSTEUERUNG 
COMBOWABEN = <MCS-TYP> MIT WEITERER <KERNWABE> VERLINKUNG 
SYSTEMWABE = EINGABE
KNOTENWABE = VERBINDET WABE DAVOR 

LINKENDWABE = VOLL. ZUSAMMENFÜHRUNG DER ANSTEUERUNG 

ENDWABE   = VOLLSTÄNDIGE ZUSAMMENFÜHRUNG DER ANSTEUERUNG 
############################################
ABKÜRZUNGEN KENNUNGEN 

# TWS STRUKTUR 
BSK = KOMPONENTEN KÜRZEL = BAUSTEINSCHALTUNGSKREISLAUF
BBSK = BION-ID = BESINDERNDER-BAUSTEINSCHALTUNGSKREISLAUF
WBBSK = WABEN-BEZIFFERNDER-BAUSTEINSCHALTUNGSKREISLAUF

# BION-ID ABKÜRZUNGS-STRUKTUR  
MID = MORPHIC-ID = <BSK>
BID = BION-ID = <BBSK> 

# BION-ID ABKÜRZUNGS-STRUKTUR
WBID = WABEN-BION-ID = <NAMEN> + <WBBSK>
############################################
DATENTYPEN  

MID = DAT 
BID = DA 01

WBID = DATENWABE = TP 
############################################
