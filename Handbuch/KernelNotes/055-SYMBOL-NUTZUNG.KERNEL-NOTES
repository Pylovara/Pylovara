; Linux x86_64: chdir(NULL) - nur als Beispiel
mov rax, 80        ; syscall nummer für chdir = 80 (x86_64)
mov rdi, 0         ; NULL pointer (kein Pfad)
syscall

wäre cirka 

48 C7 C0 50 00 00 00    ; mov rax, 80   (7 Bytes)
48 C7 C7 00 00 00 00    ; mov rdi, 0    (7 Bytes)
0F 05                   ; syscall       (2 Bytes)

