#!/bin/bash
# ==============================================================================
# Pylovara Desktop Installer Core [3.0]
# ==============================================================================
# Ort   : /Pylovara/Setup/Pylovara-System/desktop.install-core
# Zweck : Prüft Abhängigkeiten, lädt und baut den Pylovara Compositor (dwl)
# ==============================================================================

Vara_Dir="/Pylovara/System/Shell/Vara"
TARGET_DIR="/Pylovara/System/Desktop/Compositor/src"
BINARY_DEST="$Vara_Dir/dwl.vara"

echo "[PYLO-DESKTOP] Prüfe System-Abhängigkeiten..."

# Paketmanager-Erkennung & Installation
if command -v pacman >/dev/null 2>&1; then
    echo "[PYLO-DESKTOP] Arch Linux erkannt."
    NEEDED_PKGS=()
    for pkg in wlroots0.20 wayland wayland-protocols libinput libxkbcommon gcc make pkg-config; do
        if ! pacman -Qq "$pkg" >/dev/null 2>&1; then
            NEEDED_PKGS+=("$pkg")
        fi
    done

    if [ ${#NEEDED_PKGS[@]} -gt 0 ]; then
        echo "[PYLO-DESKTOP] Fehlende Pakete werden installiert: ${NEEDED_PKGS[*]}"
        sudo pacman -S --needed --noconfirm "${NEEDED_PKGS[@]}"
    else
        echo "[PYLO-DESKTOP] Alle benötigten Pakete sind bereits vorhanden."
    fi
elif command -v apt >/dev/null 2>&1; then
    echo "[PYLO-DESKTOP] Debian/Ubuntu erkannt."
    sudo apt update && sudo apt install -y libwlroots-dev wayland-protocols libinput-dev libxkbcommon-dev build-essential pkg-config
fi

# Quellcode herunterladen falls nicht da
if [ ! -d "$TARGET_DIR" ]; then
    echo "[PYLO-DESKTOP] Klone dwl-Quellcode..."
    mkdir -p "/Pylovara/System/Desktop/Compositor"
    git clone https://codeberg.org/dwl/dwl.git "$TARGET_DIR"
fi

echo "[PYLO-DESKTOP] Kompiliere Pylovara Compositor..."
cd "$TARGET_DIR" || exit 1

# Erstelle config.h aus Pylovara-Vorlage falls vorhanden
if [ -f "config.def.h" ] && [ ! -f "config.h" ]; then
    cp config.def.h config.h
fi

env -i PATH="$PATH" HOME="$HOME" make clean
env -i PATH="$PATH" HOME="$HOME" make

if [ -f "$TARGET_DIR/dwl" ]; then
    mkdir -p "$Vara_Dir"
    cp "$TARGET_DIR/dwl" "$BINARY_DEST"
    chmod +x "$BINARY_DEST"

    # Installiere SDDM / Wayland Session Eintrag
    if [ -f "/Pylovara/Setup/Pylovara-System/pylovara-desktop.session" ]; then
        sudo cp /Pylovara/Setup/Pylovara-System/pylovara-desktop.session /usr/share/wayland-sessions/pylovara.desktop 2>/dev/null
    fi

    echo "✅ [PYLO-OK] Pylovara Compositor erfolgreich kompiliert & abgelegt unter: $BINARY_DEST"
else
    echo "❌ [PYLO-ERROR] Kompilierung fehlgeschlagen."
    exit 1
fi
