@dev-notes | KERNEL-04 | PROTON/EN | C-READY-ÄQUIVALENT
####################################################################

/*
 * NAME: PROTON
 * BEGRIFFSDEFINITION: VERSORGUNGSDATENTRÄGER
 * FUNKTION: HARDWARESTEUERUNG | HARDWAREVERSORGUNG
 */

/* * PROTON-STRUKTUR
 * Protonen bewerkstelligen die Ansteuerung für verschiedene Zustände.
 * Sie werden in Proteine (Hauptdatenträger) eingebettet an die
 * jeweilige Hardware geschickt (Driver-Ersatz).
 */

// Basissymbole für die Proton-Versorgung
#define MCS_PROT_OPEN  '{'  /* GESCHWEIFTE KLAMMER AUF: Proton-Start */
#define MCS_PROT_CLOSE '}'  /* GESCHWEIFTE KLAMMER ZU:  Proton-Ende   */

/* * STANDARTLAYOUT & DEFINITIONEN (LOGIK-MAPPING)
 */

typedef struct {
    char start;             /* Symbol: { (Versorgungs-Start) */
    void *payload;          /* Inhalt: Automations-Daten    */
    char end;               /* Symbol: } (Versorgungs-Ende)  */
} mcs_proton_frame_t;

/* * ANWENDUNGSFÄLLE (PROZESS-LOGIK)
 */

// 1. PRIMÄR PHYSIKALISCHE DATEN
// Nutzung: { (Temp, Volt, Watt, Ampere) }
// C-Struktur: mcs_proton_t (siehe Kernel 01)

// 2. LOGISCHE ZUSTÄNDE
// Nutzung: { (Valid, State, Mode) }

// 3. KOMMUNIKATIONS-BEZOGEN
// Nutzung: { (Strom, Interface, Transport) }

// 4. SPEICHER-BEZOGEN
// Nutzung: { (Cache, Signed, Unsigned) }

/* * GÄNZLICHES PROTON
 * Stellt lediglich die Rahmenbedienung zur Verfügung.
 * Darstellung: { }
 */
#define MCS_PROT_BLANK "{ }"

/* * LOGIK-HINWEIS
 * Protonen nutzen primär die BOXIS des MCS-Registers, um
 * Hardware-Ablaufsteuerungen zu bewerkstelligen.
 */

####################################################################
@dev-notes | KERNEL-04 | ENDE DER PROTONEN
