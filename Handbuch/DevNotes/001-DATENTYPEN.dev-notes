####################################################################
@dev-notes | KERNEL-01 | DATENTYPEN | C-READY-ÄQUIVALENT
####################################################################

/* * KERNEL-TYPEN (Hardware-nah / Gatter-Breite)
 * Definition der Bit-Leitungen für den BMC
 */

#define MCS_T_B1    1   /* Bit-Impuls: Gatter-Steuerung (ON/OFF) [cite: 6, 7] */
#define MCS_T_B8    8   /* Kern-Byte: UTF-8 / Symbol-Einordnung [cite: 8] */
#define MCS_T_B16   16  /* Logik-Link: Sentiator-Koppelung [cite: 9] */
#define MCS_T_B32   32  /* Adress-Pfad: Legacy x86/ARM RAM-Zugriff [cite: 10, 11] */
#define MCS_T_B64   64  /* High-Speed-Pfad: Protein-Paket Transport [cite: 12] */
#define MCS_T_BINF  64  /* Massen-Typ: Streaming Gatter (Dynamisch) [cite: 13, 14] */

/* * ID-DNA-GENERATOR TYPEN
 * Physische Identitäts-Anker für þ-Validierung
 */

struct mcs_dna_anchor {
    uint32_t b_pa;      /* þ-Anker: Zeiger für Generator [cite: 15, 16] */
};

/* * PROTEIN-DATENTYPEN
 * Trägerstrukturen für den MCS-Transportrahmen
 */

typedef struct {
    void* p_key;     /* Þ-key: Identitäts-Typ (Variabel) [cite: 17, 18] */
    uint64_t init_v;    /* init-v: Start-Protein (Zündschlüssel) [cite: 19] */
    uint8_t  hnd_p[16]; /* hnd-þ: Konsens-Typ (128-Bit AIMS) [cite: 20, 21] */
    uint32_t p_cmd;     /* p-cmd: Befehls-Protein (Kernel-CMD) [cite: 22, 23] */
} mcs_protein_t;

/* * PROTON-DATENTYPEN
 * Physikalische Messwerte und Logik-Inhalte
 */

typedef struct {
    int32_t  pr_phys;   /* pr-phys: Hardware-Physik (Volt/Watt) [cite: 24, 25] */
    uint32_t f_ref;     /* f-ref: Feed-Referenz (Zero-Copy) [cite: 26, 27] */
    uint64_t pr_val;    /* pr-val: Logik-Wert (Sentiator-Basis) [cite: 28, 29] */
} mcs_proton_t;

/* * BOOT-LOGIK & MIT-SYNC (NUR BMC / HARDWARE-EBENE)
 * Root-Adressierung und Zeit-Anker
 */

#define MCS_B_ROOT  128 /* b-root: Master-Zweig (Thomas Zimmermann) [cite: 32, 33] */
#define MCS_SYS_RST 1   /* sys-rst: Hard-wired Purge (ſ) [cite: 34, 35] */

typedef struct {
    uint8_t  mit_t;     /* mit-t: Impuls-Trigger (Aktor-Status) [cite: 41, 42] */
    uint64_t mit_ref;   /* mit-ref: Zeit-Anker (Globaler Nullpunkt) [cite: 43, 44] */
    uint8_t  mit_dmp;   /* mit-dmp: Dämpfungs-Vektor (Resonanz) [cite: 46, 47] */
} mcs_mit_sync_t;

/* * REGEL DER REINHEIT (ſ)
 * Erzwungene atomare Sicherheit durch physische Nullung [cite: 36, 37]
 */
#define MCS_PURGE(ptr) memset(ptr, 0, sizeof(*ptr))

