#!/usr/bin/env bash
# MCS.Tokenizer.Core v0.5 Aktiv
# Trennt MCS-Sequenzen in geordnete Token-Elemente, robust für Protonen und Shell-Befehle

tokenize_mcs() {
    local input="$1"
    local -n _out=$2
    _out=()

    # Ersetze | außerhalb von {}-Protonen durch ein temporäres Zeichen
    local temp_input="$input"
    local temp_delim=$'\x1F'  # Unit Separator, seltenes Zeichen
    local in_proton=0
    local result=""
    local char

    # Manuelles Parsing, um | in Protonen zu erhalten
    for ((i=0; i<${#temp_input}; i++)); do
        char="${temp_input:$i:1}"
        if [[ "$char" == "{" ]]; then
            in_proton=$((in_proton + 1))
            result+="$char"
        elif [[ "$char" == "}" ]]; then
            in_proton=$((in_proton - 1))
            result+="$char"
        elif [[ "$char" == "|" && $in_proton -eq 0 ]]; then
            result+="$temp_delim"
        else
            result+="$char"
        fi
    done

    # Splitte bei temp_delim
    IFS=$temp_delim read -ra parts <<< "$result"

    for p in "${parts[@]}"; do
        # Trim Quotes für Nicht-Protonen, behalte Protonen intakt
        if [[ "$p" =~ ^\{.*\}$ ]]; then
            _out+=("$p")
        else
            # Führe Shell-Befehle in $(...) oder `...` aus
            if [[ "$p" =~ ^\$\((.*)\)$ ]]; then
                p=$(eval "${BASH_REMATCH[1]}" 2>/dev/null || echo "$p")
            elif [[ "$p" =~ ^\`(.*)\`$ ]]; then
                p=$(eval "${BASH_REMATCH[1]}" 2>/dev/null || echo "$p")
            fi
            p="$(echo "$p" | sed -E "s/^['\"]?([^'\"{}]*)['\"]?$/\1/")"
            [[ -n "$p" ]] && _out+=("$p")
        fi
    done
}

