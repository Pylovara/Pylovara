# Lernparameter (primitive!)
STATE_DECAY = 0.01        # Vergessen
STATE_GAIN  = 0.05        # Verstärkung
MUTATION_RATE = 0.02      # Variation

# Sicherheitsgrenzen
MAX_STATE_SIZE = 10_000
ALLOW_SELF_MODIFICATION = False

# Logging
VERBOSE = True
# ==============================
# SYNAPSE – Übergangsregeln
# ==============================

import random

class Synapse:
    def __init__(self, mutation_rate):
        self.mutation_rate = mutation_rate

    def apply(self, state):
        """
        Primitive Regel:
        - wähle einen Zustand
        - verändere ihn leicht
        """
        if not state.values:
            return

        key = random.choice(list(state.values.keys()))
        delta = random.uniform(-1.0, 1.0)

        # Mutation
        if random.random() < self.mutation_rate:
            delta *= random.uniform(1.5, 3.0)

        state.update(key, delta)
# ==============================
# MAIN – Startpunkt
# ==============================

from BIOS.LOOP.loop import CognitiveLoop

loop = CognitiveLoop()

for i in range(1000):
    score = loop.step()
    print(f"[{i}] score={score}")

