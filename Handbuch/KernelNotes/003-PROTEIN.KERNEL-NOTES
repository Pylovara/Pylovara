###==##==###======####REGEL: SPALTEN-SYNCHRONITÄT###======###==##==###
 # ALLE FOLGE-KOMPONENTEN MÜSSEN ZENTRAL IM ABSATZ DARUNTER EINRASTEN.
 # EINRASTMÖGLICHKEITEN BEI COMBOWABE JE NACH BEREICH :
 # - NITK  = FÜR DATENTRANSPORTE ÜBER FF UND FT 
 # - REXK  = ARBEITSFLÄCHEN VERTEILUNG (REX-LOGIK)
 # - SENK  = SENTIATOR-SCHNITTSTELLE (BEDINGUNGEN)
 # - NAVK  = NAVIGATOR-ANBINDUNG (FÜR ZIEL ADRESSIERUNGEN)
 # - RETK  = RETRON-ANBINDUNG (PROZESS REGULATIONS VERARBEITUNGS MANAGMENT)
###==##==###======###KOMPONENTEN-GENERAL-SCHALTUNG##======###==##==###
 # MASTERWORT = POIELT
 SBSK = POIK-POIX-POIELT-POIS-POIELT-POICOM-POIELT-POIE-POIELT
 VBSK = POICOM-ON-PIPE-BOXK
 VBSK = POICOM-ON-PIPE-POOK
 VBSK = POICOM-ON-PIPE-BOXK-TRENK-POOK
 VBSK = POICOM-OFF-PIPE-BOXK 
 VBSK = POICOM-OFF-PIPE-POOK 
 VBSK = POICOM-OFF-PIPE-BOXK-TRENK-POOK
 RBSK = POIK
