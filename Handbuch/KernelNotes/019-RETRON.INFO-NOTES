@info-id: RETRON-DEV
#====================================================================#

 REGULATIONSORGANISATOR

 # reguliert Abläufe
 # organisiert Wirksamkeit über Zeit
 # greift nach der Validierung ein

 # kann priorisieren, bremsen, verschieben, bündeln

 # Nicht „wer darf zuerst“, sondern:
 # wer darf wann wie stark wirken.

 # Retron¹
 # Retron²
 # Retron³ (Loop-Regulation)
 # Retron⁰ (neutralisiert, aber nicht gelöscht)

#====================================================================#
@info-id: RETRON
#====================================================================#

 RETRON REGULIERT WIRKUNG
 UND KANN BEI BEDARF BREMSEN, VORSCHIEBEN.
 RETRON IST DER PROZESSMANAGER INNERHALB EINER TRANSAKTION
 UND SORGT FÜR LASTENAUSGLEICHE UND KANN BEI BEDARF
 ARGUMENTEN LOOPS LOOPEN.

#====================================================================#