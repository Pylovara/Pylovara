 PROGRAMMIERUNGSBEREICH ↓

 # BAUT DIE SYMBOLE 
 AXIOM ¡ ZEICHEN-BAUM ≠ ^ <TASTENCODE> = *
 AXIOM ¡ ^ <TASTENCODE> = ±
 AXIOM ¡ ^ ± ≠ * ≠ ± = NI-EXTRAKTOR

 # LIEGT IM RAM
 GEBAUTE-EINHEIT ¡ ± = NI-EXTRAKTOR

###====================================|====================================###

WABEN-KATEGORIE Ð TRANSPORTWABE 

 PROGRAMM ¡ EXTRAKTOR

 WABEN-ID ¡ TP

 BION-NR ¡ 02

 BION-ID ¡ TP02

 BSK ¡ NIMKHTSTTP-EXTRAKTOR

 BION ¡ NI11MK11HT24ST24TP02

 PROGRAMMIERUNGSBEREICH ↓

 # BINDET RAM GEBAUTE-EINHEIT 
 EINHEIT ¡ ± = NI-EXTRAKTOR

 # BSK | BEENDET VOR PROZESS 
 WABEN-RESET ¡ NIMKHTST-INJEKTOR

 # HOLE KOMPONENTE
 LINK ¡ PIMK
 LINK ¡ FEMK
 
 # AXIOM | STARTET HAUPTWABE 
 AXIOM ¡ LINK ≠ PIMK ≠ PIMKHT-OFF-PIPE ≠ PIMKHTST-OFF-PIPE
 AXIOM ¡ LINK ≠ FEMK ≠ FEMKHT-FÜHREND ≠ FEMKHTSTFCCBADLD-FÜHREND

 # HOLT EINHEIT
 EINHEIT ¡ [ = OFF-PIPE-START
 EINHEIT ¡ ] = OFF-PIPE-ENDE
 EINHEIT ¡ F—(<NR>)—FØ: <CACHE> :Ø = FE-FÜHREND-DATEN

 # AXIOM | KOMBINIERT
 AXIOM ¡ NI-EXTRAKTOR + OFF-PIPE-START + FE-FÜHREND-DATEN + OFF-PIPE-ENDE ≠ * *** ≠ ± [F—(<NR>)—FØ: <CACHE> :Ø] = NI-EXTRAKTOR-DATEN

 # EINHEIT 
 EINHEIT ¡ ± [F—(<NR>)—FØ: <CACHE> :Ø] = NI-EXTRATOR-DATEN

 # AXIOM
 AXIOM ¡ PIMK ≠ PIMKHT-ON-PIPE ≠ PIMKHTSTBK-ON-PIPE
 AXIOM ¡ SYNTAX-BAUM ≠ FOOD-EXTRAKTOR 

 # FIXPUNKT VERARBEITUNGS PIPELINE
 AXIOM ¡ SYNTAX-ERLAUBNIS ≠ PIMKHTSTBK-ON-PIPE ≠ ≠ ^ *: <*>
 AXIOM ¡ ^     FOOD-EXTRAKTOR: <NIMK>

 AXIOM ¡ SPEICHER ≠ ± [F—(<NR>)—FØ: <CACHE> :Ø] = NI-EXTRATOR-DATEN

 # EINHEIT 
 EINHEIT ¡ ± [F—(<NR>)—FØ: <CACHE> :Ø] = NI-EXTRATOR-DATEN

