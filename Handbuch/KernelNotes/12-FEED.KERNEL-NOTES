 # BAUT DIE SYMBOLE 
 AXIOM ¡ ZEICHEN-BAUM ≠ ^ <TASTENCODE> = *
 AXIOM ¡ ^ <TASTENCODE> = ( 
 AXIOM ¡ ^ <TASTENCODE> = )
 AXIOM ¡ ^ <TASTENCODE> = —
 AXIOM ¡ ^ <TASTENCODE> = :
 AXIOM ¡ ^ <TASTENCODE> = Ø
 AXIOM ¡ ^ F + — + ( ≠ *** ≠ F—( = FE-FÜHREND-SPEICHERNUMMER-START
 AXIOM ¡ ^ ) + — + F ≠ *** ≠ )—F = FE-FÜHREND-SPEICHERNUMMER-KNOTEN
 AXIOM ¡ ^ Ø + : ≠ ** ≠ Ø: = FE-CACHE-START
 AXIOM ¡ ^ : + Ø ≠ ** ≠ :Ø = FE-CACHE-ENDE

 # LIEGT IM RAM
 GEBAUTE-EINHEIT ¡ F—( = FE-FÜHREND-SPEICHERNUMMER-START
 GEBAUTE-EINHEIT ¡ )—F = FE-FÜHREND-SPEICHERNUMMER-KNOTEN
 GEBAUTE-EINHEIT ¡  Ø: = FE-CACHE-START
 GEBAUTE-EINHEIT ¡ :Ø = FE-CACHE-ENDE

