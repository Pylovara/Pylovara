// mcs_system.c
#include <stdio.h>

void MCS_SYSTEM(void) {
    unsigned char RUN_FLAG = 1;  // Status-Flag, läuft / nicht läuft

    while (RUN_FLAG) {
        printf("> ");              // Prompt
        char buffer[128];
        if (!fgets(buffer, sizeof(buffer), stdin)) break;

        // Symbolische Kommandos
        if (buffer[0] == 'q') {
            RUN_FLAG = 0;           // Beenden
        } else {
            printf("Befehl: %s", buffer);
        }
    }
}

int main(void) {
    MCS_SYSTEM();                  // ENTRY
    return 0;
}

