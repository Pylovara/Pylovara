/*
 * NAME: ARGUMENT
 * BEGRIFFSDEFINITION: PROTEIN-AKTIONS-ZUSATZ
 * FUNKTION: STEUERUNG OHNE RECHENOPERATION (SIGNAL-ROUTING)
 */

/* * ARGUMENT-STRUKTUR
 * Argumente hängen sich an den Aktionsdraht « an und geben dem
 * Protein zusätzliche Ausführungsbedingungen mit (z.B. Zeit/Status).
 */

/* * DEFINITION DER ARGUMENT-TRIGGER (HARDWARE-IMPULS)
 */

// 1. ARGUMENT-TRIGGER-START
// Symbol: ««
// Funktion: Schaltet die Argumenten-Ebene für das Protein frei.
#define MCS_ARG_TRIGGER "««"

/* * ARGUMENT-OPTIONEN (STATUS-MODULATOREN)
 */

// 1. ZEIT-MODULATOR (Sekunden)
// Symbol: T
// Funktion: Löst eine zeitverzögerte oder zeitbegrenzte Verarbeitung aus.
#define MCS_ARG_TIME    'T'

// 2. EXIT-MODULATOR (Abbruch)
// Symbol: E
// Funktion: Erzwingt die Beendigung der aktuellen Verarbeitung.
#define MCS_ARG_EXIT    'E'

// 3. BESTÄTIGUNGS-MODULATOR (Admin-Interaktion)
// Symbol: B
// Funktion: Administrative Bestätigungsanfrage vor Prozess-Fortsetzung.
#define MCS_ARG_CONFIRM 'B'

/* * STANDARTLAYOUT & STRUKTUREN (LOGIK-MAPPING)
 */

typedef struct {
    char trigger[5];        /* Symbol: «« */
    char option;            /* Symbol: T | E | B */
    uint32_t val;           /* Wert (z.B. Sekunden bei T) */
} mcs_argument_t;

/* * ANWENDUNGS-LOGIK (PROZESS-MAPPING)
 */

// BEISPIEL: ZEITGESTEUERTER FEED-CLEAR (5 Sekunden Cooldown)
// » [ ~ feed cache clear 1 ~ ] ««« T5
// Logik: Aktionsende « + Argument-Trigger «« + Zeit-Option T + Wert 5.

// BEISPIEL: KRITISCHE BESTÄTIGUNG
// » [ 'format storage' ] ««« B
// Logik: Wartet auf physische Bestätigung (B), bevor Signal weiterfließt.

/* * LOGIK-HINWEIS
 * Argumente sind keine Sentiatoren. Sie bewerten nicht, sondern
 * modifizieren den Fluss des Aktionsdrahtes durch externe Faktoren
 * (Zeit, Mensch, Abbruch-Signal).
 */

####################################################################
@dev-notes | KERNEL-10 | ENDE DES ARGUMENT
####################################################################
