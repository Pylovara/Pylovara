Phase 2: mcs_transaktion.c — Zweige richtig zuweisen (ohne Peek)

ersetze das MVP-NULL durch sichere, sequenzielle Zuweisung:

// In mcs_parse_transaktion():
if (op->type == MCS_OP_WHEN_NOT && next.token_type == TOK_ACTION_START) {
    mcs_protein_t* cond = mcs_parse_next_protein(lex);
    mcs_operator_bind_condition(op, cond);
    // Zweige: NÄCHSTES Protein = THEN, ÜBERNÄCHSTES = ELSE
    if (t->protein_count >= 1) {
        op->then_branch = t->proteine[t->protein_count - 1]; // letztes Protein = THEN
    }
    // ELSE kommt später — wir warten, bis es geparst ist
}

