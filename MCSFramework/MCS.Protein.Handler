#!/usr/bin/env bash
# MCS Protein Handler v0.7 aktiv
# Ruft passende Protein-Befehle auf

handle_protein() {
    local packet="$1"
    local -a tokens=()

    # Zuerst die äußeren »[ ... ]« entfernen
    packet="${packet#»[}"
    packet="${packet%]«}"

    # Tokenizer anwenden (Trennung nach |)
    tokenize_mcs "$packet" tokens

    # Sicherheitscheck
    if [[ ${#tokens[@]} -eq 0 ]]; then
        echo "[MCS:Protein] Leeres Paket: $packet"
        return
    fi

    # Command und Argumente sauber trimmen (robust gegen Mischzeichen)
    local cmd="${tokens[0]}"
    cmd="${cmd//\"/}"
    cmd="${cmd//\'/}"
    cmd="${cmd// /}"

    local args=()
    for i in "${tokens[@]:1}"; do
        local clean="${i//\"/}"
        clean="${clean//\'/}"
        args+=("$clean")
    done

    # Kontrolle
    echo "[MCS:Protein] Ausführbar: $cmd → ${args[*]}"

    # Ausführen
    if command -v "$cmd" >/dev/null 2>&1; then
        "$cmd" "${args[@]}"
    else
        echo "[MCS:Protein] Unbekannter Befehl: $cmd"
    fi
}


