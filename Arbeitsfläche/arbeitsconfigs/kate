# ============================================================
#  PYLOVARA-KATE.CFG v1.0
#  THE-WABE-NEST-EDITOR-KONFIGURATION
#  STIL: CFG | CONFIG (REINER TEXT, KEINE SNEAKY-SYNCHRONISATION)
#  ZWECK: ZWEI UNABHÄNGIGE KATE-INSTANZEN FÜR WABEN-ARBEIT
# ============================================================

# ---------- ALLGEMEIN (Keine Synchronisation) ----------
[General]
# Sitzungen NICHT speichern
Restore Session=Disabled
Save Session on Exit=Disabled

# Keine "letzte Datei" öffnen
Open Last File=Disabled

# Keine automatischen Vorschläge
Autocomplete=Disabled
Automatic Completion=Disabled

# Keine Tooltips
Tooltips=Disabled

# Kein "Autosave"
Autosave=Disabled

# ---------- SEITENLEISTE (Links = Datei-Browser) ----------
[Sidebar]
# Datei-Browser immer links anzeigen
File Browser=Enabled
File Browser Position=Left

# Projekte-Ansicht ausblenden
Projects=Disabled

# Terminal ausblenden
Terminal=Disabled

# ---------- EDITOR (Rechts = Deine Waben) ----------
[Editor]
# Zeilenumbrüche deaktivieren
Word Wrap=Disabled

# Zeilennummern anzeigen (für die Fehlersuche)
Line Numbers=Enabled

# Leerzeichen sichtbar machen
Show Whitespace=Enabled
Show Tabs=Enabled

# Syntax-Highlighting für Waben (später eigenes hinzu)
# Vorerst "Plain Text" oder "Bash" – Bash erkennt viele Sonderzeichen gut
Syntax Highlighting=Bash

# Tabs vs. Spaces
Tab Width=4
Indent Using Spaces=Enabled
Replace Tabs=Enabled

# Keine automatische Einrückung
Auto Indent=Disabled

# ---------- SCHRIFTART (Lesbarkeit für Waben) ----------
[Font]
# Monospace-Schrift für saubere Ausrichtung
Name=Hack
Size=12
# Fallback, falls Hack nicht installiert:
# Name=DejaVu Sans Mono
# Size=12

# ---------- FARBEN (Fokus auf Kontraste) ----------
[Colors]
# Dunkles Theme für lange Arbeit
Theme=Breeze Dark
# Oder falls heller gewünscht:
# Theme=Breeze Light

# ---------- ZWEI-INSTANZEN-REGEL ----------
# Wichtig: Diese Config wird Explizit aufgerufen
# Sie überschreibt NICHT  globale Kate-Konfiguration
# Sie gilt nur für DIESE Instanz
[Behavior]
# Neues Fenster NICHT mit bestehendem verbinden
New Window Independent=Enabled

# Dateien im gleichen Fenster bleiben eigenständig
Open Files in New Window=Always

# ---------- PLUGINS (Nur das Nötigste) ----------
[Plugins]
# Datei-Browser ist das einzige Plugin, das wir brauchen
File Browser=Enabled
# Alles andere aus:
Project Plugin=Disabled
Terminal Plugin=Disabled
Snippets=Disabled
