#!/usr/bin/env bash
# MCS.SafeFrame.Core v0.1
# Ermittelt sichere Start/Endbereiche und prüft auf intakte Struktur

validate_safe_frame() {
    local line="$1"

    # Prüfen auf Start und Ende
    local has_start=0
    local has_end=0
    [[ "$line" =~ "»\[" ]] && has_start=1
    [[ "$line" =~ "\]«" ]] && has_end=1

    if (( has_start && has_end )); then
        echo "[SAFEFRAME] Vollständiges Protein erkannt."
        return 0
    elif (( has_start && !has_end )); then
        echo "[SAFEFRAME] Warnung: Protein-Start ohne Ende!"
        return 1
    elif (( !has_start && has_end )); then
        echo "[SAFEFRAME] Warnung: Protein-Ende ohne Start!"
        return 2
    fi
}

# Integration im Transaction-Core:
# ...
process_transaction() {
    local lines=("$@")
    for line in "${lines[@]}"; do
        validate_safe_frame "$line" || continue
        if [[ "$line" =~ »\[(.*)\]\« ]]; then
            handle_protein "${BASH_REMATCH[1]}"
        fi
    done
}
