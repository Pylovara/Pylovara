####################################################################

/*
 * NAME: PROTEIN
 * BEGRIFFSDEFINITION: HAUPTDATENTRÄGER
 * FUNKTION: TRANSPORTRAHMEN DER MCS-LOGIK
 */

/* * PROTEIN-STRUKTUR
 * Das Protein kapselt Boxis und Trennbefehle und bringt den
 * Kernel zum Laufen. Es definiert den Bedienungsrahmen.
 */

// Basissymbole für die Protein-Kapselung
#define MCS_PROT_OPEN  '['  /* ECKIGE KLAMMER AUF: Protein-Start */
#define MCS_PROT_CLOSE ']'  /* ECKIGE KLAMMER ZU:  Protein-Ende   */

/* * AUSFÜHRUNGSARTEN (LOGIK-MAPPING)
 */

// 1. UNAUSFÜHRBARES PROTEIN (Reiner Datenträger)
// Darstellung: []
#define MCS_PROT_DATA(content) "[" content "]"

// 2. AUSFÜHRBARES PROTEIN (Aktions-Protein)
// Darstellung: » [ ] «
#define MCS_PROT_EXEC(content) "» [" content "] «"

// 3. AUSFÜHRBARES PROTEIN + ARGUMENT (z.B. Timing)
// Darstellung: » [ ] «««t
#define MCS_PROT_EXEC_ARG(content, arg) "» [" content "] «««" arg

/* * STANDARDLAYOUT-DEFINITIONEN
 */

typedef struct {
    char start;             /* Symbol: [ (Anfangsbedienung) */
    void *payload;          /* Inhalt: Boxis / Protonen     */
    char end;               /* Symbol: ] (Endbedienung)     */
} mcs_protein_frame_t;

/* * LOGIK-HINWEIS
 * Außerhalb eines Proteins werden ausschließlich Steuerwerkzeuge
 * verwendet (Operatoren/Sentiatoren, Aktionen, Argumente,
 * Zielreferenzen, Wahrheiten, Adressierungen, Dirigenten).
 *
 * Ein "GÄNZLICHES PROTEIN" [ ] stellt lediglich die
 * Rahmenbedienung zur Verfügung, um mit Inhalten gefüllt zu werden.
 */

####################################################################
@dev-notes | KERNEL-03 | ENDE DER PROTEIN/E
####################################################################
