#!/bin/bash
# v0.2
## Quelle : /PYLOVARA-SYSTEM/ARBEITERBIENEN/CONTROL-BASH/LINUX-SHELL/SETUP/INSTALL/usr/bin/pylovara.wrapper-shell

export PV_DIR="/PYLOVARA-SYSTEM"

# Lade zentrale Config
if [ -f "$PV_DIR//ARBEITERBIENEN/CONTROL-BASH/control.pv-conf" ]; then
    source "$PV_DIR//ARBEITERBIENEN/CONTROL-BASH/control.pv-conf"
    
    # (Funktionen werden über control.pv-conf/bashrc geladen)
fi

# Starte Bash mit allen Definitionen
exec /bin/bash "$@"