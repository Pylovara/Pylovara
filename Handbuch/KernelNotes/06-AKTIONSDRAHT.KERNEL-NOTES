 # BAUT DIE SYMBOLE 
 AXIOM ¡ ZEICHEN-BAUM ≠ ^ <TASTENCODE> = *
 AXIOM ¡ ^ <TASTENCODE> = » 
 AXIOM ¡ ^ <TASTENCODE> = « 
 AXIOM ¡ ^ » ≠ * ≠ » = AK-ARGUMENT-START
 AXIOM ¡ ^ « + « ≠ ** ≠ «« = AK-ARGUMEMTE-CONNECTOR
 AXIOM ¡ ^ « ≠ * ≠ « = AK-ARGUMENT-ENDE

 # LIEGT IM RAM
 GEBAUTE-EINHEIT ¡ » = AK-ARGUMENT-START
