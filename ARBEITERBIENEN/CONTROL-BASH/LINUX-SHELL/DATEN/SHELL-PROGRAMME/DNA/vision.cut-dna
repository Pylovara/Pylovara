#!/bin/bash
# ==============================================================================
# vision.cut-dna [1.0]
# ==============================================================================
# Ort   : /PYLOVARA-SYSTEM/ARBEITERBIENEN/CONTROL-BASH/LINUX-SHELL/DATEN/SHELL-PROGRAMME/DNA/vision.cut-dna
# Zweck : Zentrales Hilfesystem mit AST-ID und *.VISION-NOTES Anbindung
# Status: STABIL - AST kompatibel - KEIN Lexikon nötig - Unabhängig
# TERMINAL : vision lex | vision <nr>
# ==============================================================================

Vara_Dir="/PYLOVARA-SYSTEM/ARBEITERBIENEN/CONTROL-BASH/LINUX-SHELL/DATEN/SHELL-PROGRAMME/VARA"
BASE_DIR="/PYLOVARA-SYSTEM/HANDBÜCHER/VISION-LEXIKON"
INPUT="$1"

extract_vision_nr() {
    $Vara_Dir/grep.vara -i '@vision-nr:' "$1" | $Vara_Dir/head.vara -n 1 | $Vara_Dir/sed.vara -E 's/.*@vision-nr:[[:space:]]*([^#[:space:]]+).*/\1/I'
}

if [[ -z "$INPUT" || "$INPUT" == "00" ]]; then
    echo "[INFO] Übersicht aller verfügbaren *.VISION-NOTES mit Nummern:"
    $Vara_Dir/find.vara "$BASE_DIR" -type f -name "*.VISION-NOTES" | while read -r file; do
        nr=$(extract_vision_nr "$file")
        name=$($Vara_Dir/basename.vara "$file")
        if [[ -n "$nr" ]]; then
            printf "%-10s -> %s\n" "$nr" "$name"
        fi
    done
    printf "[INFO] Vorgang abgeschlossen. [ENTER] zum Beenden."
    read
    return
fi

# === Fall 1: Nummernsuche ===
if [[ "$INPUT" =~ ^[0-9a-zA-Z_-]+$ ]]; then
    FOUND_PATH=$($Vara_Dir/find.vara "$BASE_DIR" -type f -name "*.VISION-NOTES" | while read -r file; do
        nr=$(extract_vision_nr "$file")
        [[ "$nr" == "$INPUT" ]] && echo "$file" && break
    done)

    if [[ -n "$FOUND_PATH" ]]; then
        echo "[INFO] Datei mit @vision-nr: $INPUT gefunden → $FOUND_PATH"
        echo "----------------------------------------"
        $Vara_Dir/cat.vara "$FOUND_PATH"
    else
        echo "[!] Keine .VISION-NOTES-DATEI mit Nummer '$INPUT' gefunden."
    fi
    printf "\n[ENTER] zum Beenden.\n"
    read
    return
fi

# === Fall 2: Dateinamen-Suche ===
SEARCH_NAME=$(echo "$INPUT" | $Vara_Dir/awk.vara '{print tolower($0)}')
FOUND_PATH=$($Vara_Dir/find.vara "$BASE_DIR" -type f -iname "${SEARCH_NAME}.VISION-NOTES" | $Vara_Dir/head.vara -n 1)

if [[ -n "$FOUND_PATH" ]]; then
    echo "[INFO] Datei '${SEARCH_NAME}.VISION-NOTES' gefunden → $FOUND_PATH"
    echo "----------------------------------------"
    $Vara_Dir/cat.vara "$FOUND_PATH"
else
    echo "[!] Keine passende .VISION-NOTES-DATEI gefunden für: $SEARCH_NAME"
fi

printf "\n[ENTER] zum Beenden.\n"
read
return
