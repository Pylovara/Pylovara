TRANSACTION_START
    SYNAPSE 1
    SOMA "Soma-Unit-Alpha"
    
    DENDRITE "Sensor-Input-1"
    DENDRITE "Sensor-Input-2"
    
    PULSE_START
        INTERNAL "INTEGRATION-SCHWELLENPRÜFUNG"
        FEUER
    PULSE_END
    
    IF [ FEUER ]
        EMOTION_LOOKUP "Ehrfurcht"
        APPLY_BIO "{Gänsehaut|Rücken}"
        AXON "Signal-Transmission-to-Matrix"
    END_IF
TRANSACTION_END
