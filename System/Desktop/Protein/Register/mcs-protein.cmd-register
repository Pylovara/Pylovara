#!/usr/bin/env bash
# /Pylovara/System/Desktop/Protein/Register/mcs-protein.cmd-register
# MCS Protein Command Register v1.0

declare -A PROTEIN_REG
# Original PoC Commands
PROTEIN_REG[echo]="SYSTEM_MESSAGE"
PROTEIN_REG[send]="FILE_TRANSFER"
PROTEIN_REG[run]="PROCESS_EXEC"
PROTEIN_REG[bestätigen]="USER_INPUT_CHECK"

# Neue MCS Desktop Wrapper (MAB) Befehle
PROTEIN_REG[puls]="SOURCE_COMMAND"    # Ersetzt 'source'
PROTEIN_REG[pushout]="VARIABLE_SET"   # Ersetzt 'export' / 'local' Zuweisung
PROTEIN_REG[pushin]="FILE_IMPORT"    # Lädt Dateiinhalt in eine Variable (Import)
PROTEIN_REG[hyprctl]="NATIVE_EXEC"    # Für native Hyprland-Befehle
PROTEIN_REG[cd]="NATIVE_TO"           # Wird durch Alias 'to' ersetzt, aber hier registriert
