#!/usr/bin/env bash
# Pylovara MCS Transaction Handler + Protein Interpreter (v0.9) Aktiv
# Neu: þ-ID-Validierung für jede Transaktion

TX_START="¢!"
TX_END="!¢"
TX_ACTIVE=0
declare -a TX_CONTENT=()

source /Pylovara/MCSFramework/MCS.SafeFrame.Core
source /Pylovara/MCSFramework/MCS.Tokenizer.Core
source /Pylovara/MCSFramework/MCS.Protein.Register
source /Pylovara/MCSFramework/MCS.Protein.Handler
source /Pylovara/MCSFramework/MCS.Proton.Register
source /Pylovara/MCSFramework/MCS.Proton.Handler
source /Pylovara/MCSFramework/MCS.þ.Register

start_transaction() {
    TX_ACTIVE=1
    TX_CONTENT=()
}
end_transaction() {
    TX_ACTIVE=0
    echo "=== Transaction abgeschlossen ==="
    printf "%s\n" "${TX_CONTENT[@]}"
    process_transaction "${TX_CONTENT[@]}"
    TX_CONTENT=()
}
process_transaction() {
    local lines=("$@")
    local th_id=$(uuidgen 2>/dev/null || date +%s%N | md5sum | cut -d' ' -f1)
    echo "[MCS:Transaction] þID generiert: þ$th_id"
    for line in "${lines[@]}"; do
        validate_safe_frame "$line" || continue
        if [[ "$line" =~ »\[(.*)\]\« ]]; then
            handle_protein_packet "${BASH_REMATCH[1]}" "$th_id"
        fi
    done
}
while IFS= read -r line; do
    if [[ "$line" == "$TX_START"* ]]; then
        start_transaction; TX_CONTENT+=("$line"); continue
    fi
    if [[ "$line" == *"$TX_END" ]]; then
        TX_CONTENT+=("$line"); end_transaction; continue
    fi
    [[ $TX_ACTIVE -eq 1 ]] && TX_CONTENT+=("$line")
done < "${1:-/dev/stdin}"


