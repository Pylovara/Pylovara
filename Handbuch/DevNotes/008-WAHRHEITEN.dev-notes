/* * WAHRHEITEN HAUPTKLASSE (SCHALTUNG)
 * Das Symbol – (Bindestrich) triggert die Unterklassen/Optionen.
 */
#define MCS_TRUTH_TRIGGER  '–' 

/* * WAHRHEITEN UNTERKLASSE (AUSWERTUNG/ERGEBNIS)
 * Das Symbol = (Istgleich) extrahiert das Ergebnis direkt aus der ALU.
 */
#define MCS_TRUTH_FETCH    '='

/* * KOMBINIERTE LOGIK-GATTER (-=)
 * Schaltet die Kernklasse für die Ergebnisauswertung scharf.
 */
#define MCS_TRUTH_VALIDATE "-="

/* * STANDARTLAYOUT & STRUKTUREN
 */

typedef struct {
    uint8_t trigger_active;  /* Aktiviert durch – */
    void* alu_output;      /* Geholt durch = */
    char    senti_clean;     /* Regel der Reinheit ſ */
} mcs_truth_gate_final_t;

/* * PRÄZISIONS-MUSTERBEISPIEL (LOGIK-FLUSS)
 * ¢!
 * »[×2·4×]«               // 1. ALU-Rechnung
 * -= »["8"]«              // 2. Schaltung scharf + Ergebnis-Fetch
 * -> »["4"]«           // 3. Folge-Zustand
 * ¶ »[×–4×]«        // 4. Sentiator (Kann) + neue ALU-Rechnung
 * -= »["4"]«      // 5. Validierung des neuen Ergebnisses
 * ſ »[~lösch]«««t3 // 6. REINHEIT: Löschung nach 3 Sek.
 * !¢
 */

/* * SPEZIAL-SENTIATOR: REINHEIT (ſ)
 * Erkennt Datenmüll und löscht das Register (physikalische Nullung).
 */
#define MCS_SENTI_PURGE   "ſ"

/* * BOXI-KLASSE: MCS-CMD (~ ~)
 * Direkte Verbindung zum hauseigenen MCS-Register.
 * Steuert interne Elemente wie FEEDS oder CACHE-LÖSCHUNG.
 */
#define MCS_CMD_START     '~'
#define MCS_CMD_END       '~'

/* * LOGIK-HINWEIS
 * Die Adressierung (=) für Zielreferenzen bleibt standalone, 
 * während im Kontext der Wahrheiten das -= die ALU-Bindung erzwingt.
 */

