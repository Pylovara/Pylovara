@mcs_nr: 01
# Status : Sammeln | Aufbau
# Version 0.1
####################################################################
## USA Datentypen
####################################################################
// Datentypen
int       // Ganzzahlen
float     // Kommazahlen
string    // Text
bool      // Wahrheitswert

####################################################################
## Deutsche Datentypen – MCS Kern-Typisierung
####################################################################

Ganzzahl     // entspricht int
Gleitkomma   // entspricht float
Zeichenkette // entspricht string
Wahrheitswert // entspricht bool
Liste        // Array / Liste
Wörterbuch   // Dictionary / Map
Bytefolge    // byte array
Nichts       // void / null

## Erweiterte Typen für Hardware/System
ProzessID
HardwarePfad
NetzwerkAdresse
Taktzeit
Speicherblock


Abgeleitete / zusammengesetzte Typen
C-Typ   Beschreibung
array[] Feld von    Werten gleichen Typs
struct  Struktur    – mehrere Typen kombiniert
union   Union       – Speicherüberlagerung
enum    Aufzählung  – benannte Integer-Konstanten
pointer Zeiger      – Speicheradresse eines Typs
function pointer    Zeiger auf Funktion

####################################################################
## MCS Deutsche Datentypen – Zentrum
####################################################################

## Grundtypen
Zeichen        // char
KleinZahl      // short
Ganzzahl       // int
GroßZahl       // long
RiesigZahl     // long long
GleitZahl      // float
DoppelGleit    // double
LangGleit      // long double
Wahrheit       // _Bool
Leer           // void

## Vorzeichen-Modifikatoren
OhneVorzeichen  // unsigned
MitVorzeichen   // signed

## Komplexe Typen
Liste[Typ]     // array
Struktur       // struct
Union          // union
Aufzählung      // enum
Zeiger[Typ]    // pointer
FunktionsZeiger // function pointer

## Systemtypen
Byte8          // int8_t
Byte16         // int16_t
Byte32         // int32_t
Byte64         // int64_t
ZeigerGröße    // intptr_t
SpeicherGröße  // size_t
MaximalZahl    // intmax_t

## Qualifizierer
Konstant       // const
Flüchtig       // volatile
Atomar         // _Atomic
Einzig         // restrict

## Hardware-nahe (zu deinen *.*-needles passend)
RegisterWert
SpeicherBlock
InterruptCode
GPIO_Pin
DMA_Channel
IRQ_Nummer

System-/Plattform-spezifische Typen (aus stdint.h)
Typ     Beschreibung
int8_t,  uint8_t genau 8 Bit
int16_t, uint16_t genau 16 Bit
int32_t, uint32_t genau 32 Bit
int64_t, uint64_t genau 64 Bit
intptr_t, uintptr_t Größe eines Zeigers
size_t Größe für Speichergrößen
ptrdiff_t Differenz zwischen Zeigern
intmax_t, uintmax_t größtmöglicher Integer


Grundlegende (primitive) Datentypen in C
C-Typ   Größe (typisch) Bereich (typisch)   Beschreibung
char    1 Byte -128 … 127 / 0 … 255 Zeichen / kleine Ganzzahl
unsigned char   1 Byte  0 … 255 nur positive Werte
signed char 1 Byte  -128 … 127   explizit vorzeichenbehaftet
short   2 Byte  -32.768 … 32.767    kurze Ganzzahl
unsigned short  2 Byte   0 … 65.535    nur positiv
int 4 Byte  -2,147 Mio … +2,147 Mio Standard-Ganzzahl
unsigned int    4 Byte  0 … 4,294 Mio   nur positiv
long    4 oder 8 Byte   größer als int   lange Ganzzahl
unsigned long   wie long  nur positiv
long long   8 Byte  sehr groß   sehr lange Ganzzahl
unsigned long long  8 Byte  nur positiv
float   4 Byte    ~6-7 Dezimalstellen    Gleitkomma einfach
double  8 Byte   ~15 Dezimalstellen    Gleitkomma doppelt
long double 10, 12 oder 16 Byte noch genauer    erweiterte Genauigkeit
_Bool (C99) 1 Byte  0 oder 1    Wahrheitswert
void    –   "nichts" / leerer Typ


@kernel-nr: 16
####################################################################
## MCS Datentypen-Zentrum – Deutsche Systematik
####################################################################

## 1. Numerische Typen
Ganzzahl       // Standard-Integer, systemabhängig
Fix32          // immer 32 Bit (int32_t)
Fix64          // immer 64 Bit (int64_t)
Gleit32        // float
Gleit64        // double

## 2. Zeichen und Text
Zeichen        // Einzelzeichen (char)
Zeichenkette   // Text (char[])
Breitzeichen   // wchar_t (für Unicode)

## 3. Logik
Wahrheit       // bool (0 oder 1)
Wahrheitsfeld  // bit array

## 4. Speicher und Zeiger
Speicheradresse // void*
Zeiger[Typ]    // Typsicherer Zeiger
Referenz       // Alias-Name

## 5. Hardware-Typen (für *.*-needles)
Register       // CPU-Register
Port           // I/O-Port
Interrupt      // IRQ-Nummer
Speicherbereich // physischer RAM-Bereich

## 6. System-Typen
ProzessID      // PID
DateiDeskriptor // fd
NutzerID       // uid
Gerät          // dev_t

## 7. Container
Liste[Typ]     // Array
Paar[Typ1,Typ2] // Tuple
Abbildung[Schlüssel,Wert] // Map
