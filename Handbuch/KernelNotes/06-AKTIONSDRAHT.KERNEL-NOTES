 # BINDET RAM GEBAUTE-EINHEIT 
 GEBAUTE-EINHEIT ¡ » = AK-ARGUMENT-START
 GEBAUTE-EINHEIT ¡ «« = AK-ARGUMEMTE-CONNECTOR
 GEBAUTE-EINHEIT ¡ « = AK-ARGUMENT-ENDE

 # WENN GEBRAUCHT | BEENDET VOR PROZESS
 WABEN-BSK-RESET ¡ AKMKHTST-ARGUMENT-IMPULS

 # LINK FÜR PIMK 
 LINK ¡ PIMK

 # BENÖTIGTE PASSIVE PROTEIN-EINHEITEN (DATENTRÄGER)
 EINHEIT ¡ —[<BXMK>] = ON-PIPE-BX-FINAL
 EINHEIT ¡ —[<POMK>] = ON-PIPE-PO-FINAL
 EINHEIT ¡ [<BXMK>] = OFF-PIPE-BX-FINAL
 EINHEIT ¡ [<POMK>] = OFF-PIPE-PO-FINAL
 EINHEIT ¡ [<BXMK><TEMK><POMK>] = OFF-PIPE-BTP-FINAL

 # AXIOMEN (ZÜNDUNG: SYNTHESE AUS AKTIONSDRAHT + PROTEIN)
 AXIOM ¡ AUSFÜHRBAR2 ≠ AK-ARGUMENT-START + ON-PIPE-BX-FINAL + AK-ARGUMEMTE-CONNECTOR ≠ »—[<BXMK>]««« = AUSFÜHRBAR2
 AXIOM ¡ AUSFÜHRBAR2 ≠ AK-ARGUMENT-START + ON-PIPE-PO-FINAL + AK-ARGUMEMTE-CONNECTOR ≠ »—[<POMK>]««« = AUSFÜHRBAR2
 AXIOM ¡ AUSFÜHRBAR2 ≠ AK-ARGUMENT-START + OFF-PIPE-BX-FINAL + AK-ARGUMEMTE-CONNECTOR ≠ »[<BXMK>]««« = AUSFÜHRBAR2
 AXIOM ¡ AUSFÜHRBAR2 ≠ AK-ARGUMENT-START + OFF-PIPE-PO-FINAL + AK-ARGUMEMTE-CONNECTOR ≠ »[<POMK>]««« = AUSFÜHRBAR2
 AXIOM ¡ AUSFÜHRBAR2 ≠ AK-ARGUMENT-START + OFF-PIPE-BTP-FINAL + AK-ARGUMEMTE-CONNECTOR ≠ »[<BXMK><TEMK><POMK>]««« = AUSFÜHRBAR2

 # LINK ARGUMENT 
 LINK ¡ BXMK

 # AXIOM 
 AXIOM ¡ LINK ≠ BXMK ≠ BXMKHT-MCD

 # AXIOM MCD 
 AXIOM ¡ AUSFÜHRBAR2 + BXMKHT-MCD + AK-ARGUMENT-ENDE ≠ »—[<BXMK>]«««~: <MCD> :~« = AUSFÜHRBAR1
 AXIOM ¡ AUSFÜHRBAR2 + BXMKHT-MCD + AK-ARGUMENT-ENDE ≠ »—[<POMK>]«««~: <MCD> :~« = AUSFÜHRBAR1
 AXIOM ¡ AUSFÜHRBAR2 + BXMKHT-MCD + AK-ARGUMENT-ENDE ≠ »[<BXMK>]«««~: <MCD> :~« = AUSFÜHRBAR1
 AXIOM ¡ AUSFÜHRBAR2 + BXMKHT-MCD + AK-ARGUMENT-ENDE ≠ »[<POMK>]«««~: <MCD> :~« = AUSFÜHRBAR1
 AXIOM ¡ AUSFÜHRBAR2 + BXMKHT-MCD + AK-ARGUMENT-ENDE ≠ »[<BXMK><TEMK><POMK>]«««~: <MCD> :~« = AUSFÜHRBAR1

