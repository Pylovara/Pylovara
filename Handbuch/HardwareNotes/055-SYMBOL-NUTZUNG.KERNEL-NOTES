¢!   # Transaktionsrahmen – kompletter Game-Start-Prozess "Halo Infinite".proto

  »[~MASTER-CONTROL INIT LEVEL=10~]«                        # Spalte 2 – Master-Trigger
   -·¤= ["(MASTER:PHASE)±GAME-LAUNCH-SEQUENCE±"]«           # Spalte 4 – Zuweisung mit FF

  # ────────────────────────────────────────────────────────────────
  # PHASE 0: EXE BINARY VALIDATION & MANUELLER LOW-LEVEL LOAD
  # ────────────────────────────────────────────────────────────────
  »['exec "C:\Games\HaloInfinite\HaloInfinite.exe"']«       # Spalte 2 – Shell-Trigger
   -·¤: ["EXE-PFAD-GELOCKT"]«                               # Spalte 4

  ¶ -· [~MANUAL-PE-LOAD~]«                                  # Spalte 2 – Sentiatior + REX
    # Sub-Workspace A: Header-Prüfung

      »[~READ PE-HEADER FROM DISK~|"C:\Games\HaloInfinite\HaloInfinite.exe"]«  # Spalte 6
       -·¤= ["(FF:PE-RAW-HEADER)±...±"]«                    # Spalte 8 – Führender Feed: Header-Daten
      »[~CHECK MZ SIGNATURE~]«                              # Spalte 6
       ¶ »[× MZ-MAGIC == 0x5A4D ×]«                         # Spalte 8
            -·¤= ["(TF:PE-DOS-VALID)±TRUE±(FF:PE-RAW-HEADER)"]«  # Spalte 10 – Tragender Feed synchronisiert
       ¶¶ »[~ABBRUCH "KEIN MZ HEADER – KEIN PE!"~]«         # Spalte 8
            -· »[~FEHLERBERICHT-ZU ¬ /Pylovara/FEHLER/PE_INVALID_MZ.log~]«««ſ  # Spalte 10 – Reinheit + Abbruch
      »[~LOCATE PE-HEADER OFFSET~]«                         # Spalte 6
       -·¤= ["(FF:PE-OFFSET)±±(FF:PE-RAW-HEADER+0x3C)±"]«   # Spalte 8 – Führender Feed: Offset
      »[~CHECK PE SIGNATURE "PE\0\0"~]«                     # Spalte 6
       ¶ »[× PE-MAGIC == 0x00004550 ×]«                     # Spalte 8
            -·¤= ["(TF:PE-VALID)±TRUE±(FF:PE-OFFSET)"]«      # Spalte 10 – Tragender Feed: Validierung

    # Sub-Workspace B: Sections mappen
    -··                                                     # Spalte 4
      »[~PARSE OPTIONAL HEADER~]«                           # Spalte 6
       -··¤= ["(FF:IMAGE-BASE)±0x140000000±"]«              # Spalte 8 – Führender Feed: Image-Base
       -··¤= ["(FF:ENTRY-RVA)±±(FF:OPTIONAL+16)±"]«         # Spalte 8 – Führender Feed: Entry-RVA
      »[~ALLOC VIRTUAL MEMORY~|BASE=±(FF:IMAGE-BASE)± SIZE=±(FF:SIZE-OF-IMAGE)±]«  # Spalte 6
       -··¤= ["(TF:BASE-ALLOC)±SUCCESS±(FF:IMAGE-BASE)"]«   # Spalte 8 – Tragender Feed: Allokation
      »[~FOR EACH SECTION HEADER~]«                         # Spalte 6
       -··                                                  # Spalte 8
         ¶ »[~SECTION RVA + BASE VALID?~]«                  # Spalte 10
              »[~MAP SECTION TO VA~|VA=±(FF:IMAGE-BASE)± + ±SECTION-RVA± RAW=±SECTION-RAW-OFFSET± SIZE=±SECTION-VIRTUAL-SIZE±]«  # Spalte 12
               -··¤= ["(TF:SECTION-MAPPED)±TRUE±(FF:IMAGE-BASE)"]«  # Spalte 14 – Tragender Feed: Mapping-Status
         ¶¶ »[~RELOCATE IF NEEDED~]«                       # Spalte 10
              -·· »[~APPLY BASE RELOCS~]«                   # Spalte 12
              -··¤= ["(TF:RELOCS-APPLIED)±TRUE±(FF:IMAGE-BASE)"]«  # Spalte 14

    # Sub-Workspace C: IAT patchen
    -···                                                    # Spalte 4
      »[~PARSE IMPORT DIRECTORY~]«                          # Spalte 6
       -···¤= ["(FF:IAT-RVA)±...±"]«                        # Spalte 8 – Führender Feed: IAT-RVA
      »[~RESOLVE DLLs & FUNCTIONS~]«                        # Spalte 6
       -···                                                 # Spalte 8
         »[~LOADKERNEL32~]«                                 # Spalte 10
          -···¤= ["(TF:KERNEL32-LOADED)±TRUE±(FF:IAT-RVA)"]«  # Spalte 12 – Tragender Feed: Load-Status
      »[~PATCH IAT IN MEMORY~]«                             # Spalte 6
       -···¤= ["(TF:IAT-PATCHED)±TRUE±(FF:IAT-RVA)"]«       # Spalte 8 – Tragender Feed: Patch-Status

    # Jump to Entry Point
    »[~JUMP-TO ±(FF:IMAGE-BASE)± + ±(FF:ENTRY-RVA)± ~]«     # Spalte 6 – Nutzt führende Feeds
     -·¤: ["(TF:EXE-ENTRY-REACHED)±TRUE±(FF:IMAGE-BASE)"]«   # Spalte 8 – Tragender Feed: Entry-Status

  # ────────────────────────────────────────────────────────────────
  # PHASE 1: GPU-NEEDLE-CHAIN
  # ────────────────────────────────────────────────────────────────
  ¶ -· [~RUN-GPU-NEEDLE-CHAIN~]«««Ω                         # Spalte 2 – Sentiatior + REX + Loop
    –··¤› »['exec /Pylovara/System/Module/nvidia_driver.TREIBER-NEEDLE']«  # Spalte 4
           ¶ -·· [~INIT nvidia.GPU-CORE~]«««Ω              # Spalte 6
                 -··¤= ["(FF:GPU-CORE)±ACTIVE±"]«           # Spalte 8 – Führender Feed: Core-Status
           ¶ -·· [~INIT nvidia.GPU-LCORE~]«««T120          # Spalte 6
                 -··¤= ["(TF:GPU-LCORE)±READY±(FF:GPU-CORE)"]«  # Spalte 8 – Tragender Feed
           ¶ -·· [~INIT nvidia.GPU-VCORE~]«««T180          # Spalte 6
                 -··¤= ["(TF:GPU-VCORE)±READY±(FF:GPU-CORE)"]«  # Spalte 8
           ¶ -·· [~INIT nvidia.GPU-MCORE~]«««T240          # Spalte 6
                 -··¤= ["(TF:GPU-MCORE)±READY±(FF:GPU-CORE)"]«  # Spalte 8
           ¶ -·· [~INIT nvidia.GPU-FCORE~]«««T300          # Spalte 6
                 -··¤= ["(TF:GPU-FCORE)±READY±(FF:GPU-CORE)"]«  # Spalte 8
                 »[~PROTON STATUS~|"{GPU:MODEL|RTX4090|STATUS|FULLY_LOADED}"]«  # Spalte 8

           # Fallback-Kette
           ¶¶ -·· »[~GPU-INIT-FAILED~]«                    # Spalte 6
                   -·· »[~MACH DATEITYPE-FLAG ERROR~]«     # Spalte 8
                   -·· »[~FEHLERBERICHT-ZU ¬ /Pylovara/FEHLER/GPU_CHAIN_FAIL.log~]«  # Spalte 8
                   -·· »[~FALLBACK-TO INTEL UHD~]«         # Spalte 8
                        »['exec /Pylovara/System/Module/intel_uhd.TREIBER-NEEDLE']«  # Spalte 10
                        »[~PROTON STATUS~|"{GPU:MODEL|UHD770|STATUS|FALLBACK}"]«  # Spalte 10

  # ────────────────────────────────────────────────────────────────
  # PHASE 2–5: PARALLELE SYSTEM-MODULE
  # ────────────────────────────────────────────────────────────────
  »['exec /Pylovara/System/Module/directx12.treiber-needle']«  # Spalte 2
   -·¤= ["(TF:DX12-READY)±TRUE±(FF:GPU-FCORE)"]«            # Spalte 4 – Tragender Feed bindet an GPU-Status
   ¶ »[~BIND-TO ±TF:GPU-FCORE± ~]«                          # Spalte 4

  »['exec /Pylovara/System/Module/audio.system-kernel']«   # Spalte 2
   -··¤= ["(TF:AUDIO-READY)±TRUE±"]«                       # Spalte 4

  »['exec /Pylovara/System/Module/network.system-kernel']« # Spalte 2
   -·· »[~CONNECT-TO "xbox-live.net"~]«                    # Spalte 4
        -··¤= ["(TF:NETWORK-READY)±TRUE±"]«                # Spalte 6

  »['exec /Pylovara/System/Module/overlay.system-kernel']« # Spalte 2
   -···¤= ["(TF:OVERLAY-READY)±TRUE±"]«                    # Spalte 4

  »[~MONITOR RUNTIME~]«««Ω                                 # Spalte 2 – Background-Loop
   ¶ »[× FPS < 55 ×]«                                      # Spalte 4
        -···· »[~PROTON ADJUST~|"{GPU:THROTTLE|DOWN|FPS_LOW}"]«  # Spalte 8
   ¶ »[× GPU-TEMP > 84 ×]«                                 # Spalte 4
        -···· »[~PROTON THROTTLE~|"{GPU:CLOCK|REDUCE|OVERHEAT}"]«  # Spalte 8
        -···· »[~FEHLERBERICHT-ZU ¬ /Pylovara/MONITOR/THERMAL.log~]«  # Spalte 8

  # ────────────────────────────────────────────────────────────────
  # PHASE FINAL: MATRIX-SYNC
  # ────────────────────────────────────────────────────────────────
  »['exec /Pylovara/System/Module/8taktryhtmus.system-kernel']«  # Spalte 2
   ¶ -· »[~SYNC MATRIX~]«                                   # Spalte 4
        ¶ »[× ALL(±TF:EXE-ENTRY-REACHED±, ±TF:GPU-FCORE±, ±TF:DX12-READY±, ±TF:AUDIO-READY±, ±TF:NETWORK-READY±) == TRUE ×]«  # Spalte 6
             -· »['echo "[MATRIX] ALLE SYSTEME BEREIT – LAUNCH!"]'«  # Spalte 8
             -· »[~PROTON STATUS~|"{GAME:STATE|RUNNING|Halo Infinite}"]«  # Spalte 8
             -· »['exec "C:\Games\HaloInfinite\HaloInfinite.exe" --fullscreen --dx12']«  # Spalte 8
        ¶¶ »[× TIMEOUT 15000 TAKTE ×]«                     # Spalte 6
             -· »[~ABBRUCH "MATRIX-SYNC TIMEOUT – HARD FAIL"]'«  # Spalte 8
