import javax.swing.JFrame;
import java.awt.event.WindowAdapter;
import java.awt.event.WindowEvent;

public class WindowChangeExample {
    public static void main(String[] args) {
        JFrame frame = new JFrame("Fenster-Erkennung");
        
        // Reagiert auf Fokus- oder Zustandsänderungen des Fensters
        frame.addWindowListener(new WindowAdapter() {
            @Override
            public void windowIconified(WindowEvent e) {
                System.out.println("Fenster wurde minimiert.");
            }

            @Override
            public void windowDeiconified(WindowEvent e) {
                System.out.println("Fenster wurde wiederhergestellt.");
            }

            @Override
            public void windowActivated(WindowEvent e) {
                System.out.println("Fenster ist jetzt aktiv (im Vordergrund).");
            }
        });

        frame.setSize(400, 300);
        frame.setDefaultCloseOperation(JFrame.EXIT_ON_CLOSE);
        frame.setVisible(true);
    }
}

