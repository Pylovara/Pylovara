# --- HILFSFUNKTIONEN FÜR PUSHIN/PUSHOUT ---

# MCS.Pushout.Command: Exportiert einen Wert (Argument 2) in eine Variable (Argument 1)
mcs_pushout_command() {
    local var_name="$1"
    local value="$2"
    local tx_id="$3"

    if [[ -z "$var_name" || -z "$value" ]]; then
        echo "[MCS:Error:pushout] Variablennamen oder Wert fehlt. Syntax: ['pushout'|'VAR'|'VALUE']"
        return 1
    fi

    # Das 'export' macht die Variable global in der aktuellen Shell-Umgebung
    export "$var_name"="$value"

    local truncated_value="${value:0:30}..."
    if [[ ${#value} -le 30 ]]; then truncated_value="$value"; fi

    echo "[MCS:pushout:þ$tx_id] $var_name exportiert ('$truncated_value')."
    return 0
}

# MCS.Pushin.Command: Importiert den Inhalt eines Pfades (Argument 2) in eine Variable (Argument 1)
mcs_pushin_command() {
    local var_name="$1"
    local file_path="$2"
    local tx_id="$3"

    if [[ -z "$var_name" || -z "$file_path" ]]; then
        echo "[MCS:Error:pushin] Variablennamen oder Dateipfad fehlt. Syntax: ['pushin'|'VAR'|'/path']"
        return 1
    fi

    if [[ ! -f "$file_path" ]]; then
        echo "[MCS:Error:pushin] Datei nicht gefunden oder nicht lesbar: $file_path"
        return 2
    fi

    # Liest den gesamten Dateiinhalt in die Variable
    local file_content
    file_content=$(cat "$file_path")

    # Exportiert die Variable mit dem Dateiinhalt
    export "$var_name"="$file_content"

    echo "[MCS:pushin:þ$tx_id] '$file_path' (Länge: ${#file_content}) in $var_name importiert."
    return 0
} # <-- HIER MUSS DIE KLAMMER DER HILFSFUNKTION SCHLIESSEN

# --- HAUPTFUNKTION: PROTEIN PACKET HANDLER ---

handle_protein_packet() {
    local packet="$1"
    local th_id="$2"
    local -a tokens=()

    # Aufruf der zentralen Tokenizer-Funktion (Muss gesourced sein)
    tokenize_mcs "$packet" tokens

    [[ ${#tokens[@]} -eq 0 ]] && {
        echo "[MCS:Protein] Leeres Paket."
        return
    }

    local cmd="${tokens[0]//[\'\"]}"
    local args=("${tokens[@]:1}")

    # Prüfen, ob Befehl im Register existiert (Muss gesourced sein)
    if [[ -z "${PROTEIN_REG[$cmd]}" ]]; then
        echo "[MCS] Fehler: Unbekannter Befehl '$cmd' (Nicht im Protein-Register)."
        return 1
    fi

    echo "[MCS:Protein] erkannt → $cmd (Funktion: ${PROTEIN_REG[$cmd]})"

    # --- NATIVE AUSFÜHRUNGS-LOGIK (Die Brücke zu Bash) ---
    case "$cmd" in
        puls)
            # »['puls' |/path/to/script.sh]« (Ersetzt: source /path/to/script.sh)
            local path_to_source="${args[0]}"
            if [[ -z "$path_to_source" ]]; then
                echo "[MCS:Error:puls] Pfad zur Quelle fehlt."
                return 1
            fi

            echo "[MCS:MAB] Pülsiere Daten von Quelle: $path_to_source (Native: source)"
            # NATIVE BASH EXECUTION
            source "$path_to_source"
            ;;

        pushout)
            # Ruft die Pushout-Funktion auf: »['pushout'|'VAR_NAME'|'VALUE']«
            mcs_pushout_command "${args[0]}" "${args[1]}" "$th_id"
            ;;

        pushin)
            # Ruft die Pushin-Funktion auf: »['pushin'|'VAR_NAME'|'/path/to/file']«
            mcs_pushin_command "${args[0]}" "${args[1]}" "$th_id"
            ;;

        hyprctl)
            # »['hyprctl'|'keyword'|'general:col.active_border']«
            echo "[MCS:MAB] Führe Hyprctl-Befehl aus: ${args[*]}"
            # NATIVE BASH EXECUTION
            hyprctl "${args[@]}"
            ;;

        echo)
            echo "${args[*]}"
            ;;

        send)
            # PoC Logik
            local target="${args[0]}"
            echo "[MCS:Protein] Sende $target mit þ$th_id"
            ;;

        *)
            echo "[MCS] Unbekannter Proteinbefehl: $cmd (Prüfe mcs-protein.cmd-register)"
            ;;
    esac # <-- HIER SCHLIESST DER CASE-BLOCK
} # <-- HIER SCHLIESST DIE HAUPTFUNKTION

