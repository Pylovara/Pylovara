#!/usr/bin/env bash
# ==============================================================================
# info_extractor.sh - Extrahiert spezifischen @info-id: Abschnitt aus *.INFO-NOTES
# ==============================================================================
# Aufruf: info <SUCH_ID>   z.B. info PROTEINE   oder   info MASTER-CONTROL
# ==============================================================================

HANDBUCH_DIR="/Pylovara/Handbuch/KernelNotes"
SUCHID="$1"

if [[ -z "$SUCHID" ]]; then
    echo "[!] Nutzung: $(basename "$0") <INFO-ID>"
    echo "    Beispiel: $(basename "$0") PROTEINE"
    exit 1
fi

FOUND=0

# Durchsuche alle *.INFO-NOTES Dateien
while IFS= read -r file; do
    # Awk-Programm: Extrahiere den passenden Abschnitt
    TREFFER=$(awk -v id="$SUCHID" '
    BEGIN { capturing = 0 }
    {
        # Prüfe auf @info-id: Zeile (auch mit führenden Leerzeichen)
        if ($0 ~ /^[[:space:]]*@info-id:/) {
            # Extrahiere ID nach dem Doppelpunkt
            sub(/^[[:space:]]*@info-id:[[:space:]]*/, "")
            current_id = $0
            gsub(/[[:space:]]+$/, "", current_id)  # Trim trailing space

            if (current_id == id) {
                capturing = 1
                print "[info] Abschnitt \"" id "\" gefunden in: " FILENAME
                print $0  # Die @info-id: Zeile selbst ausgeben
                next
            } else if (capturing) {
                # Nächster Abschnitt beginnt → vorherigen beenden
                exit
            }
        }
        if (capturing) {
            print $0
        }
    }
    ' "$file")

    if [[ -n "$TREFFER" ]]; then
        echo "$TREFFER"
        FOUND=1
        break  # Erster Treffer reicht
    fi
done < <(find "$HANDBUCH_DIR" -type f -name "*.INFO-NOTES" 2>/dev/null)

if [[ $FOUND -eq 0 ]]; then
    echo "[!] Kein Abschnitt zu '@info-id: $SUCHID' gefunden."
fi
