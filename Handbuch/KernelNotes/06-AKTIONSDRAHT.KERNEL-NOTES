 # BENÖTIGTE PASSIVE PROTEIN-EINHEITEN (DATENTRÄGER)
 EINHEIT ¡ —[<BXMK>] = ON-PIPE-BX-FINAL
 EINHEIT ¡ —[<POMK>] = ON-PIPE-PO-FINAL
 EINHEIT ¡ [<BXMK>] = OFF-PIPE-BX-FINAL
 EINHEIT ¡ [<POMK>] = OFF-PIPE-PO-FINAL
 EINHEIT ¡ [<BXMK><TEMK><POMK>] = OFF-PIPE-BTP-FINAL

 # AXIOMEN (ZÜNDUNG: SYNTHESE AUS AKTIONSDRAHT + PROTEIN)
 AXIOM ¡ AUSFÜHRBAR ≠ AK-START + ON-PIPE-BX-FINAL + AK-ENDE ≠ »—[<BXMK>]« = AUSFÜHRBAR
 AXIOM ¡ AUSFÜHRBAR ≠ AK-START + ON-PIPE-PO-FINAL + AK-ENDE ≠ »—[<POMK>]« = AUSFÜHRBAR
 AXIOM ¡ AUSFÜHRBAR ≠ AK-START + OFF-PIPE-BX-FINAL + AK-ENDE ≠ »[<BXMK>]« = AUSFÜHRBAR
 AXIOM ¡ AUSFÜHRBAR ≠ AK-START + OFF-PIPE-PO-FINAL + AK-ENDE ≠ »[<POMK>]« = AUSFÜHRBAR
 AXIOM ¡ AUSFÜHRBAR ≠ AK-START + OFF-PIPE-BTP-FINAL + AK-ENDE ≠ »[<BXMK><TEMK><POMK>]« = AUSFÜHRBAR

 # LIEGT IM RAM 
 EINHEIT ¡ »—[<BXMK>]« = AUSFÜHRBAR
 EINHEIT ¡ »—[<POMK>]« = AUSFÜHRBAR
 EINHEIT ¡ »[<BXMK>]« = AUSFÜHRBAR
 EINHEIT ¡ »[<POMK>]« = AUSFÜHRBAR
 EINHEIT ¡ »[<BXMK><TEMK><POMK>]« = AUSFÜHRBAR

