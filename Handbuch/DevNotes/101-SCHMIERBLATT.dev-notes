¶ »["is_large"]
   ['gzip "$file_path"']«
   -= »["compress_ok"]«
       ¶ »["compress_ok"]
     ['file_path="${file_path}.gz"']«
     -= »["new_path"]«
»[~transfer box ¬ mach feed 2 ~|(2)"${file_path}.gz"]«
 ¶¶ »["is_large"]
     ["Datei ist klein, keine Komprimierung nötig."]«



