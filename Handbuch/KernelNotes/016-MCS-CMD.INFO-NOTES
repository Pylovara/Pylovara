   - kopiere = Kopiert Datei/Inhalt
   - kopierehier = Sendet als Kopie an Ziel
----------------------------------------------------------------------
 REGISTER-COMMAND-KLASSE = CMD-ÖFFNEN
 FUNKTION = DATEI-/PROGRAMMZUGRIFF
