 REGISTER COMMAND KLASSE = CMD-LÖSCHUNG

 löschung =

 der befehl alleine löscht alles in einer zeile

 -- -- -- -- -- -- -- -- -- -- -- -- -- -- -- -- -- -- -- -- -- --

 löschung transaktionsrahmen =

 der befehl löscht alles in dem dadeityp

 -- -- -- -- -- -- -- -- -- -- -- -- -- -- -- -- -- -- -- -- -- --

 löschung protein =

 löscht das protein

 -- -- -- -- -- -- -- -- -- -- -- -- -- -- -- -- -- -- -- -- -- --

  löschung proton =

  löscht das proton im protein

--------------------------------------------------------------------

 REGISTER COMMAND KLASSE = CMD-TRANSFER

 transfer boxi =

 zieht letzten Boxi inhalt darüber raus und legt es rechts
 in das selbe protein nach dem Trennbefehl

--------------------------------------------------------------------

  REGISTER COMMAND KLASSE = CMD-FEED

  mach feed <NR> =

  setzt ein führenden feed an das kommende BOXI

 -- -- -- -- -- -- -- -- -- -- -- -- -- -- -- -- -- -- -- -- -- --

  löschung führender feed <NR> =

  Löscht FührenderFeed und damit auch auch sein Tragenden Feed

 -- -- -- -- -- -- -- -- -- -- -- -- -- -- -- -- -- -- -- -- -- --

  löschung feed cache <NR> =

  sucht den feed cache der dann per nummer geholt wird und den
  inhalt löscht/leert

