 # HOLT KOMPONENTE DAZU
 LINK ¡ BXMK

 # KOPPLUNG AN PIPELINE-BOX
 AXIOM ¡ LINK ≠ ON-PIPE-START + BXMK ≠ ^ COMBI = —[<BXMK>
 AXIOM ¡ ^ MCS-TYP-ON-PIPE-BXMK = —[<BXMK>

 # LIEGT IM RAM 
 EINHEIT ¡ —[<BXMK> = ON-PIPE-START-BXMK

