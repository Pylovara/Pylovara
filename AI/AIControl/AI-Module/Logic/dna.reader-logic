#!/usr/bin/env bash
# ──── dna.reader-logic ───────────────────────────────────────────────
# TYPE: verhaltens-logic
# NAME: dna-reader
# VERSION: 0.1
# FOKUS: Durchsuchung & Anzeige von *.wiki-notes Dateien
# ──────────────────────────────────────────────────────────────────────

DNA_DIR="/Pylovara/Handbuch/DnaNotes/"

prompt_user() {
  local answer
  read -rp "$1 [y/n]: " answer
  [[ "$answer" == "y" ]]
}

search_dna() {
  echo "[*] Bitte gib ein Suchwort für die .dna-notes ein:"
  read -rp ">> " query
  echo "[*] Suche nach: $query in $DNA_DIR ..."

  grep -rin --color=always "$query" "$DNA_DIR"
}

show_filelist() {
  echo "[*] Verfügbare .dna-notes:"
  find "$DNA_DIR" -type f -name "*.dna-notes"
}

choose_file_to_view() {
  echo "[*] Datei anzeigen? (vollständiger Pfad eingeben)"
  read -rp ">> " file
  if [[ -f "$file" && "$file" == *.dna-notes ]]; then
    if prompt_user ">> Datei anzeigen: $file?"; then
      less "$file"
    else
      echo "[*] Abgebrochen."
    fi
  else
    echo "[!] Datei ungültig oder nicht gefunden."
  fi
}

main_loop() {
  while true; do
    echo ""
    echo "[dna.reader] Optionen:"
    echo "1) Suche in .dna-notes"
    echo "2) Liste der .dna-notes anzeigen"
    echo "3) Datei ansehen"
    echo "4) Beenden"
    read -rp ">> Auswahl: " choice

    case "$choice" in
      1) search_dna ;;
      2) show_filelist ;;
      3) choose_file_to_view ;;
      4) echo "[*] dna.reader ENDE."; break ;;
      *) echo "[!] Ungültige Auswahl." ;;
    esac
  done
}

main_loop

