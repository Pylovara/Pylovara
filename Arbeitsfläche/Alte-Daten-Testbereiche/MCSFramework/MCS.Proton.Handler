#!/usr/bin/env bash
# Modul: MCS.Proton.Handler
# Version: 0.7 Aktiv
# Neu: þ-Checksum-Validierung mit TH_REG

source /Pylovara/MCSFramework/MCS.þ.Register

parse_proton() {
    local token="$1"
    [[ "$token" =~ ^\{(.*)\}$ ]] || return
    local inner="${BASH_REMATCH[1]}"
    IFS='|' read -r -a parts <<< "$inner"
    local name="${parts[0]}"
    local value="${parts[1]}"

    # Checksum-Validierung
    if [[ "$name" == "Checksum" ]]; then
        if [[ ! "$value" =~ ^þ[0-9a-f]{32}$ ]]; then
            echo "[MCS:Proton] Unhackbar: Ungültige Checksum: $value"
            return 1
        fi
        local checksum_type="${value%%þ*}"
        if [[ -n "$checksum_type" && -z "${TH_REG[$checksum_type]}" ]]; then
            echo "[MCS:Proton] Unhackbar: Unbekannter Checksum-Typ: $checksum_type"
            return 1
        fi
    fi

    echo "[MCS:Proton] erkannt → Name=$name | Wert=$value"

    # Register-Abfrage
    if [[ -z "${PROTON_REG[$name]}" ]]; then
        echo "[MCS:Proton] Unbekannter Proton-Typ: $name"
        return 1
    fi

    if [[ "$value" =~ ^\{.*\}$ ]]; then
        parse_proton "$value"  # Rekursion
    fi

    case "$name" in
        Wait-s)
            echo "[MCS:Proton] Sleep ${value}s..."
            sleep "$value"
            ;;
        Signed)
            echo "[MCS:Proton] Signatur-ID: ${value}"
            ;;
        Checksum)
            echo "[MCS:Proton] Checksum validiert: $value"
            ;;
    esac
}


