# Quelle : /Pylovara/Setup/MCS-Hyprland-Dotfiles/waybar/config

{
  "layer": "top",
  "position": "top",
  "modularity": 4,
  "height": 30,
  "exclusive": true,

  "modules-left": [
    "hyprland/workspaces",
    "hyprland/window"
  ],
  "modules-center": [
    "custom/pylovara-status"
  ],
  "modules-right": [
    "pulseaudio",
    "backlight",
    "battery",
    "clock",
    "tray"
  ],

  // --- MCS MODUL DEFINITION ---
  "custom/pylovara-status": {
    "format": "🔥 {text} 🔥",
    // Führt das MCS-Skript aus, um Status zu erhalten
    "exec": "bash /home/$USER/.config/waybar/scripts/mcs-status.sh",
    "interval": 5, // Alle 5 Sekunden aktualisieren
    "tooltip": true,
    // Führt bei Klick eine MCS-Transaktion im Monopol-Terminal aus
    // Beachte: Wir starten kitty -e bash -c um die MCS-Aliase zu laden!
    "on-click": "kitty -e bash -c 'source /Pylovara/System/Desktop/wrapper/aliase.wrapper-needles; echo \"\\n📦 MCS System Status DNA-Anfrage:\\n\"; »[\"system\"|\"dna-core\"]«; read -p \"\\n<ENTER> zum Schließen...\"'",
    "return-type": "json"
  },

  // --- Standardmodule (minimalistisch) ---
  "hyprland/workspaces": {
    "format": "{icon}",
    "format-icons": {
      "active": "●",
      "default": "○"
    }
  },
  "clock": {
    "format": "{:H:%M}"
  }
}
