#!/usr/bin/env bash
# MCS.Tokenizer.Core v0.1
# Trennt MCS-Sequenzen in geordnete Token-Elemente

tokenize_mcs() {
    local input="$1"
    local -n _out=$2
    _out=()

    local IFS="|"
    read -ra parts <<< "$input"

    for p in "${parts[@]}"; do
        p="$(echo "$p" | sed -E "s/^['\"]?(.*?)['\"]?$/\1/")"
        [[ -n "$p" ]] && _out+=("$p")
    done
}
