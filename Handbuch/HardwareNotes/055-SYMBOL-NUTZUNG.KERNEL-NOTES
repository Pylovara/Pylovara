### ==== ##### == # = NEUERE BEISPIEL SCHALTUNGEN = # == ##### === ###

¢|
# 1. 10 MB in Bytes berechnen (ALU-RECHNER)
»[× 10 · 1024 · 1024 ×]«
 ¬·¤= »["(1)±10485760±"]«

# 2. Ergebnis in Feed 1 speichern (CMD-FEED)
»[~TRANSFER BOXIS ¬ MACH TF 1~|"±10485760±(1)"]«

# 3. Dateigröße mit Feed 1 vergleichen (SENTIATOR-MEHRWERT)
»[× $file_size > ±WERT±(1) ×]«
 ¬··¤= »["is_large"]«

# 4. Wenn größer (SENTIATOR-KANN-IMPULS)
     ¶ ¬·· »["is_large"]
     # 4a. Komprimieren (SHELL-CONTROL)
           ¬·· ['gzip "$file_path"']«
           ¬·· »["compress_ok"]«

            ¶ »["compress_ok"]
            # 4b. Pfad erweitern (SHELL-CONTROL)
               ['file_path="${file_path}.gz"']«
               ¬···¤= »["new_path"]«

# 4c. Neuen Pfad in Feed 2 speichern
»[~TRANSFER BOXIS ¬ MACH FF 2~|"(2)±${file_path}.gz±"]«
# 5. Wenn nicht größer (SENTIATOR-NICHT-IMPULS)
 ¶¶ ¬··> »["is_large"]«««t5
    ¬··> »["Datei ist klein, keine Komprimierung nötig."]«««t6
¢|

¢!
# ============================================
# MCS-CAESAR: Verschlüsselung mit Shift
# EINGABE: SHIFT TEXT
# AUSGABE: VERSCHLÜSSELTER TEXT
# ============================================

»['echo Caesar-Verschlüsselung startet']«

# 1. Eingabe-Parameter als PROTEIN entgegennehmen
»[~CAESAR SHIFT 3 TEXT HalloWelt~]«
 ¬·¤: ['Parameter empfangen']«

# 2. SHIFT und TEXT in FEED 1 und 2 ablegen
»[~EXTRACT SHIFT~|"3"]«
 ¬··¤= »["(1)±3±"]«        # FEED 1 = Shift

»[~EXTRACT TEXT~|"HalloWelt"]«
 ¬···¤= »["(2)±HalloWelt±"]« # FEED 2 = Text

# 3. Verarbeitungsschleife initialisieren (REX-WORKSPACE)
»[× 0 = i ×]«              # Zähler i = 0
»[× ±WERT±(2) = text ×]«   # Text aus FEED 2
»[× ±WERT±(1) = shift ×]«  # Shift aus FEED 1

¶ »[× i < LÄNGE(text) ×]«  # SENTIATOR: Schleifenbedingung
    # 3a. Zeichen holen
    »[× text[i] = ch ×]«
    
    # 3b. Großbuchstabe?
    »[× ch >= 'A' AND ch <= 'Z' ×]«
     ¬·¤= »["(3)±true±"]«
        »[× ch = ch - 'A' + shift ×]«
        »[× ch = ch % 26 ×]«
        »[× ch = ch + 'A' ×]«
        »[× text[i] = ch ×]«
        »['echo Großbuchstabe verschoben']«
    
    ¶¶ ¬·»[× ch >= 'a' AND ch <= 'z' ×]«  # SENTIATOR-NICHT für Kleinbuchstaben
          ¬··¤= »["(4)±true±"]«
         »[× ch = ch - 'a' + shift ×]«
         »[× ch = ch % 26 ×]«
         »[× ch = ch + 'a' ×]«
         »[× text[i] = ch ×]«
         »['echo Kleinbuchstabe verschoben']«
    
    # 3c. i erhöhen
    »[× i = i + 1 ×]«
     ¬···¤: ['Schleife Iteration']«

# 4. Ergebnis zurück in FEED 3
»[~STORE RESULT~|"±text±(3)"]«

# 5. Ausgabe (BOXIS-CALLIS)
»['echo Verschlüsselter Text:']«
»["±WERT±(3)"]«

# 6. Cleanup (Regel der Reinheit)
ſ ¬· [~PROZESS BEENDEN~]«

