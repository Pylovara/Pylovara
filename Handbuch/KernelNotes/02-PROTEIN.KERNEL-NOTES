 # FINALE INTEGRATION (VERPACKUNG SCHLIESSEN)
 AXIOM ¡ ON-PIPE-START-BXMK + ON-PIPE-ENDE ≠ ^ COMBI = —[<BXMK>]
 AXIOM ¡ ^ MCS-TYP-ON-PIPE-FINAL = —[<BXMK>]

 # FERTIGES ON-PIPE PROTEIN (ABGABE AN ALU/HW)
