[18:09:20|Mo Dez 15]

Heute werden paralelle prozesse und transporte im mcs_runner.c eingefügt in mcs_run_transaktion

alter bereich :


int mcs_run_transaktion(mcs_transaktion_t* t) {
    if (!t || !t->is_valid) return MCS_ERR_SYNTAX;

    // 🔹 Semantische Auswertung der Transaktions-Bedingung (z.B. ° [...])
    if (t->wahrheit != WAHR_NONE && t->condition) {
        mcs_semantic_op_t op = mcs_wahrheit_to_semantic(t->wahrheit);
        mcs_truth_t cond = mcs_evaluate_condition(t->condition);

        switch (op) {
            case SEMANTIC_WHEN_NOT:  // °
                if (cond == MCS_FALSE && t->protein_count > 0 && t->proteine && t->proteine[0] && t->proteine[0]->then_branch) {
                    return mcs_run_protein(t->proteine[0]->then_branch);
                }
                if (cond == MCS_TRUE && t->protein_count > 0 && t->proteine && t->proteine[0] && t->proteine[0]->else_branch) {
                    return mcs_run_protein(t->proteine[0]->else_branch);
                }
                break;

            case SEMANTIC_IF:  // ¶ — theoretisch möglich auf Transaktionsebene
                if (cond == MCS_TRUE && t->protein_count > 0 && t->proteine && t->proteine[0] && t->proteine[0]->then_branch) {
                    return mcs_run_protein(t->proteine[0]->then_branch);
                }
                break;

            default: break;
        }
    }

neuer bereich :


// In mcs_run_transaktion(), nach der Schleife über Proteine:
for (int i = 0; i < t->protein_count; i++) {
    mcs_protein_t* p = t->proteine && i < t->protein_count ? t->proteine[i] : NULL;
    if (!p) continue;

    if (p->wahrheit != WAHR_NONE) {
        mcs_semantic_op_t op = mcs_wahrheit_to_semantic(p->wahrheit);

        switch (op) {
            case SEMANTIC_IF: {
                if (p->then_branch) mcs_run_protein(p->then_branch);
                break;
            }
            case SEMANTIC_ELSE: {
                if (p->else_branch) mcs_run_protein(p->else_branch);
                break;
            }
            case SEMANTIC_PARALLEL: {  // ¶=
                if (p->action) {
                    pid_t pid = fork();
                    if (pid == 0) {
                        // Kindprozess: führe Aktion aus & exit
                        mcs_run_action(p->action);
                        exit(0);
                    } else if (pid > 0) {
                        printf("[PARALLEL] Gestartet: PID %d\n", (int)pid);
                        // Elternprozess: NICHT warten → weiter
                    } else {
                        fprintf(stderr, "[ERROR] fork() fehlgeschlagen\n");
                    }
                }
                break;
            }
            case SEMANTIC_PARALLEL_TRANSPORT: {  // ;;
                // Beispiel: (1)¨$pgrep firefox¨ → Feed setzen, aber nicht blockieren
                if (p->action && p->action->blankernenner && p->action->feed.id > 0) {
                    // Async-Feed-Set — später mit pthread oder Signal
                    // PLACEHOLDER_ASYNC_FEED — MVP: synchron, aber markiert
                    mcs_run_action(p->action);  // MVP: noch synchron, aber Semantik klar
                }
                break;
            }
            default:
                mcs_run_protein(p);
        }
    } else {
        mcs_run_protein(p);
    }
}

sind dahinter ist es das system generell linear zu halten wo es sinn ergibt
und lineare verarbeitung kann auch bit technisch skalieren .....
wenn wir in die zuckunft denken an bessere cpus oder gpus oder tpus ,
dann können wir sogar die bit rate skalieren , mcs wäre dafür quasi wie
gebaut bzw exzellent geeignet ...


Warum linear & sicher?

    fork() → keine Threads, kein Lock, kein Deadlock
    Elternprozess geht sofort weiter → echte Parallelität
    Kein Zustands-Sharing — nur über Feeds (mcs_feed_set/get)


um parallele transporte zu testen lege ich eine neue tadatei an

im Core/test_parallel.mcs

¢!
»['echo 1. Hauptprozess startet']«
;; [(1)¨date¨]                   # Feed 1 setzen — ohne Blockieren (MVP: synchron)
¶= »['echo 2. Parallel-Prozess']««t2
»['echo 3. Hauptprozess läuft weiter']«
»['echo Feed 1:(1)']«   # Wert aus Feed nutzen
!¢

