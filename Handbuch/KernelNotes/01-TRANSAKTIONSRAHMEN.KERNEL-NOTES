 # BAUT DIE SYMBOLE 
 AXIOM ¡ ZEICHEN-BAUM ≠ ^ ≠ * = *
 AXIOM ¡ ^ <TASTENCODE> = ¢ 
 AXIOM ¡ ^ <TASTENCODE> = ! 
 AXIOM ¡ ¢ + ! ≠ ** ≠ ¢!
 AXIOM ¡ ! + ¢ ≠ ** ≠ !¢
 
 # EINHEIT
 EINHEIT ¡ ¢! = MCS-BLOCK-START
 EINHEIT ¡ !¢ = MCS-BLOCK-ENDE

