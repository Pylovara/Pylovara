@kernel-nr: 55 # SYMBOL-NUTZUNG | STATUS = Ŋ Schmierzettel Freigegeben
#  LEXIKON NAVIGATION TERMINAL = kernel <NUMMER> | info <INFO-ID>    #
### ==== ##### == # = SYMBOL-NUTZUNGSKATEGORIEN  == # == ##### === ###
#
# A) RAHMEN-SYMBOLE:
#    ¢! … !¢   – Transaktionsrahmen
#    » … «     – Aktionsdraht-Container
#    [ ]       – Protein-Rahmen
#    { }       – Proton-Rahmen
#
# B) STEUER-SYMBOLE:
#    ¶         – SENTIATOR-WENN-KANN
#    ¶¶        – SENTIATOR-NICHT
#    -·        – REX-WORKSPACE-A
#    -··       – REX-WORKSPACE-B
#
# C) DATEN-SYMBOLE:
#    ±WERT±(n) – FEED-Bindung
#    °(n)°     – BLANKERNENNER (Zwischenspeicher)
#    (n)       – FEED-Container
#
# D) OPERATIONS-SYMBOLE:
#    × … ×     – ALU-RECHNER
#    ' … '     – SHELL-CONTROL
#    " … "     – CALLIS (STDOUT)
#    , … ,     – SYSCALL
#    ~ … ~     – MCS-CMD
#
### ==== ##### == # =============================== # == ##### === ###

