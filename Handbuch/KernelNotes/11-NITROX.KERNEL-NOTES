 # BINDET RAM GEBAUTE-EINHEIT 
 EINHEIT ¡ ÷ = NI-INJEKTOR

 # BSK | BEENDET VOR PROZESS 
 WABEN-RESET ¡ NIMKHTST-INJEKTOR

 # HOLE KOMPONENTE
 LINK ¡ PIMK
 LINK ¡ FEMK
 
 # AXIOM | STARTET HAUPTWABE 
 AXIOM ¡ LINK ≠ PIMK ≠ PIMKHT-OFF-PIPE ≠ PIMKHTST-OFF-PIPE
 AXIOM ¡ LINK ≠ FEMK ≠ FEMKHT-TRAGEND ≠ FEMKHTSTFCCBADLD-TRAGEND

 # HOLT EINHEIT
 EINHEIT ¡ [ = OFF-PIPE-START
 EINHEIT ¡ ] = OFF-PIPE-ENDE
 EINHEIT ¡ T—(<NR>)—TØ: <CACHE> :Ø = FE-TRAGEND-DATEN

 # AXIOM | KOMBINIERT
 AXIOM ¡ NI-INJEKTOR + OFF-PIPE-START + FE-TRAGEND-DATEN + OFF-PIPE-ENDE ≠ * *** ≠ ÷ [T—(<NR>)—TØ: <CACHE> :Ø] =  NI-INJEKTOR-DATEN

 # EINHEIT 
 EINHEIT ¡ ÷ [T—(<NR>)—TØ: <CACHE> :Ø] = NI-INJEKTOR-DATEN

 # AXIOM
 AXIOM ¡ PIMK ≠ PIMKHT-ON-PIPE ≠ PIMKHTSTBK-ON-PIPE
 AXIOM ¡ SYNTAX-BAUM ≠ KOPF-INJEKTOR 

 # FIXPUNKT VERARBEITUNGS PIPELINE
 AXIOM ¡ SYNTAX-ERLAUBNIS ≠ PIMKHTSTBK-ON-PIPE ≠ ≠ ^ *: <*>
 AXIOM ¡ ^     KOPF-INJEKTOR: <NIMK>

 AXIOM ¡ SPEICHER ≠ NI-INJEKTOR-DATEN

 # EINHEIT 
 EINHEIT ¡ ÷ [T—(<NR>)—TØ: <CACHE> :Ø] NI-INJEKTOR-DATEN

