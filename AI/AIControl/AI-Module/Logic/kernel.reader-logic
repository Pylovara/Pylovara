#!/usr/bin/env bash
# ──── kernel.reader-logic ───────────────────────────────────────────────
# TYPE: verhaltens-logic
# NAME: kernel-reader
# VERSION: 0.1
# FOKUS: Durchsuchung & Anzeige von *.wiki-notes Dateien
# ──────────────────────────────────────────────────────────────────────

KERNEL_DIR="/Pylovara/Handbuch/KernelNotes/"

prompt_user() {
  local answer
  read -rp "$1 [y/n]: " answer
  [[ "$answer" == "y" ]]
}

search_kernel() {
  echo "[*] Bitte gib ein Suchwort für die .kernel-notes ein:"
  read -rp ">> " query
  echo "[*] Suche nach: $query in $KERNEL_DIR ..."

  grep -rin --color=always "$query" "$KERNEL_DIR"
}

show_filelist() {
  echo "[*] Verfügbare .kernel-notes:"
  find "$KERNEL_DIR" -type f -name "*.kernel-notes"
}

choose_file_to_view() {
  echo "[*] Datei anzeigen? (vollständiger Pfad eingeben)"
  read -rp ">> " file
  if [[ -f "$file" && "$file" == *.kernel-notes ]]; then
    if prompt_user ">> Datei anzeigen: $file?"; then
      less "$file"
    else
      echo "[*] Abgebrochen."
    fi
  else
    echo "[!] Datei ungültig oder nicht gefunden."
  fi
}

main_loop() {
  while true; do
    echo ""
    echo "[kernel.reader] Optionen:"
    echo "1) Suche in .kernel-notes"
    echo "2) Liste der .kernel-notes anzeigen"
    echo "3) Datei ansehen"
    echo "4) Beenden"
    read -rp ">> Auswahl: " choice

    case "$choice" in
      1) search_kernel ;;
      2) show_filelist ;;
      3) choose_file_to_view ;;
      4) echo "[*] kernel.reader ENDE."; break ;;
      *) echo "[!] Ungültige Auswahl." ;;
    esac
  done
}

main_loop

