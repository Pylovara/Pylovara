####################################################################
@dev-nr: 11 | KERNEL-11 | FEED/S | C-READY-ÄQUIVALENT
####################################################################

/*
 * NAME: FEED
 * BEGRIFFSDEFINITION: SYNCHRONISATIONSRAHMEN
 * FUNKTION: PUNKTUELLE TRANSPORTVERDRAHTUNG (DATENKANAL)
 */

/* * FEED-STRUKTUR
 * Ein Feed legt einen Cache-Speicher im RAM/BMC an. Er teilt sich
 * in Führende Feeds (FF - Datenaufnahme) und Tragende Feeds
 * (TF - Datenausgabe). Dies ermöglicht Zero-Copy-Datentransfer.
 */

/* * DEFINITION DER FEED-KOMPONENTEN
 */

// 1. FEED-RAHMEN (Ohne Kennziffer / Generisch)
// Symbol: ( )
#define MCS_FEED_FRAME_OPEN  '('
#define MCS_FEED_FRAME_CLOSE ')'

// 2. FÜHRENDER FEED (FF)
// Position: IMMER Links von einem BOXI.
// Funktion: Nimmt Informationen auf und schreibt in den Cache.
// Beispiel: (1)"Daten"

// 3. TRAGENDER FEED (TF)
// Position: Innerhalb einer BOXI.
// Funktion: Liest Informationen aus dem zugewiesenen Cache.
// Beispiel: ["Daten: (1)"]

/* * STANDARTLAYOUT & STRUKTUREN (LOGIK-MAPPING)
 */

typedef struct {
    uint32_t feed_id;       /* Kennziffer (Zahl/Buchstabe/Kombi) */
    void* cache_ptr;     /* Zeiger auf den physischen Cache */
    size_t   cache_size;    /* Größe des reservierten Sektors */
    uint8_t  is_leading;    /* Flag: FF (1) oder TF (0) */
} mcs_feed_t;

/* * FEED-MAPPING NACH BOXI-TYPEN
 * Je nach Boxi-Typ ändert sich die Notation der Zuweisung
 */

// (1)" "  <-- FF an BOXI CALLIS
// (2)' '  <-- FF an BOXI SHELL-CONTROL
// (3)~ ~  <-- FF an BOXI MCS-CMD
// (4), ,  <-- FF an BOXI CALL-CONTROL
// (5)¨ ¨  <-- FF an BOXI Blankernenner

/* * TRAGENDE FEEDS (INNERHALB BOXI)
 */

// "(1)"   <-- TF in Eingabe Print
// '(2)'   <-- TF in Eingabe Shell CMD
// ’(3)’   <-- TF in Eingabe MCS CMD
// ,(4),   <-- TF in Eingabe System-Steuerung
// ¨(5)¨   <-- TF in Eingabe Blankernenner

/* * LOGIK-HINWEIS
 * Feeds bilden die "Blutbahnen" des Systems. Ein FF kann auch
 * hartcodierte Eingaben tragen. Die Synchronisation erfolgt über
 * die Kennziffer (ID).
 */

####################################################################
@dev-notes | KERNEL-11 | ENDE DER FEEDS
