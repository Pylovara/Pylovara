@mcsplus-nr: 01 | Operatoren | Testfälle | MCSPLUS |
####################################################################
# Test der Grundoperatoren
# ALU soll direkt die Ergebnisse liefern
####################################################################

# Test Addition
test PLUS {
    operand1 = 5
    operand2 = 3
    erwarte = 8
}

# Test Subtraktion
test MINUS {
    operand1 = 5
    operand2 = 3
    erwarte = 2
}

# Test Multiplikation
test MAL {
    operand1 = 5
    operand2 = 3
    erwarte = 15
}

# Test Division
test GETEILT {
    operand1 = 15
    operand2 = 3
    erwarte = 5
}
