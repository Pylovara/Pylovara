┌────────────────────────────────────────────────────────────────────┐
 # gallery.nidus
 # NIDUS = Das Nest - der Startprozess

 name: "Bildergalerie"
 version: "1.0"
 entry: "main.nodus"
 bootloader: true

 # Der Equilizer (Regelung aller NODUS)
 equilizer:
   memory_limit: "512MB"
   priority: "normal"

└────────────────────────────────────────────────────────────────────┘
┌────────────────────────────────────────────────────────────────────┐
 # main.nodus
 # NODUS = Der Knoten - Daten, Assets, Bibliotheken

 assets:
   - type: "image"
     nexus: "hero.nexus"
     path: "/assets/hero.jpg"
  
   - type: "image"  
     nexus: "thumb.nexus"
     path: "/assets/thumbnails/*.jpg"
  
   - type: "config"
     nexus: "settings.nexus"
     path: "/config/gallery.json"

 libraries:
   - "render.nodus"
   - "ui.nodus"
└────────────────────────────────────────────────────────────────────┘
┌────────────────────────────────────────────────────────────────────┐
 # hero.nexus  
 # NEXUS = Die Verbindung - Linker, Loader, Mapping

 name: "hero-image"
 source: "/assets/hero.jpg"
 target: "main.nodus"
 mapping:
   position: "top"
   size: "large"
   lazy_load: false
└────────────────────────────────────────────────────────────────────┘
┌────────────────────────────────────────────────────────────────────┐
 # thumb.nexus
 # NEXUS = Verbindet Thumbnails mit der Galerie

 name: "thumbnails"
 source: "/assets/thumbnails/*.jpg"
 target: "main.nodus"
 mapping:
   grid: "3x3"
   lazy_load: true
   cache: "128MB"
└────────────────────────────────────────────────────────────────────┘

 Benutzer klickt auf "Bildergalerie"
        │
        ▼
 ┌─────────────────┐
 │  gallery.nidus  │  ← Startet den Prozess
 │  (NIDUS)        │
 └────────┬────────┘
         │ "Ich brauche die Hauptdaten"
         ▼
 ┌─────────────────┐
 │   main.nodus    │  ← Lädt alle Assets
 │   (NODUS)       │
 └────────┬────────┘
         │ "Wo ist das Hero-Bild?"
         ▼
 ┌─────────────────┐
 │   hero.nexus    │  ← Sagt: hero.jpg gehört nach oben, groß
 │   (NEXUS)       │
 └────────┬────────┘
         │
         ▼
 ┌─────────────────┐
 │  hero.jpg       │  ← Die eigentliche Datei wird geladen
 └─────────────────┘
         │
         ▼
 ┌─────────────────┐
 │  Bild wird oben │
 │  groß angezeigt │
 └─────────────────┘

