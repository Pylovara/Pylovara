######################## erster entwurf :

###=====================NEUE AXIOM-PROGRAMMIERUNG=========================###

### SYMBOL-LEXIKON (jedes Symbol = ein Befehl)

SYMBOL-LEXIKON ¡

  # GRUNDSYMBOLE (Operatoren)
  ⠁ = START / BEGINN
  ⠂ = IDENTIFIKATION / NAME
  ⠄ = NUMMER / WERT
  ⡀ = KOMBINATION / VERBINDUNG
  ⠈ = ABSCHLUSS / ENDE
  
  # LOGISCHE VERKNÜPFER
  ⑅ = ISTGLEICH / ZUWEISUNG
  ⌬ = KETTE / SEQUENZ
  ː = PFAD / WEG
  ⌯ = KNOTEN / PUNKT
  
  # DATENFLUSS
  ║ = PARALLEL / GLEICHZEITIG
  ⍅ = EINGABE / INPUT
  ◘ = AUSGABE / OUTPUT
  
  # KONTROLLFLUSS
  ˦ = AUFSTEIGEND / FORWÄRTS
  ˧ = ABSTEIGEND / RÜCKWÄRTS
  ⑆ = SCHLEIFE / WIEDERHOLUNG
  ⑅ = BEDINGUNG / WENN-DANN

###----------------------------------------------------

### AXIOM-PROGRAMMIERUNG (nur mit Symbolen)

# BEISPIEL 1: WABEN-DEFINITION
AXIOM ¡ ⠁ + ⠂ + ⠄ ⑅ ⡀

# BEDEUTET:
# START + NAME + NUMMER = KOMBINATION
# → Eine neue Wabe beginnt

# BEISPIEL 2: BION-ID
AXIOM ¡ ⠂ + ⠄ ː ⡀ ⑅ ⠈

# BEDEUTET:
# NAME + NUMMER → KOMBINATION = ENDE
# → Die BION-ID ist komplett

# BEISPIEL 3: DATENFLUSS
AXIOM ¡ ⍅ + ː + ◘ ⑅ ║

# BEDEUTET:
# INPUT → OUTPUT = PARALLEL
# → Daten fließen parallel

# BEISPIEL 4: KONTROLLFLUSS
AXIOM ¡ ˦ + ⑆ + ˧ ⑅ ⌬

# BEDEUTET:
# FORWÄRTS + SCHLEIFE + RÜCKWÄRTS = SEQUENZ
# → Eine Schleife wird definiert

###----------------------------------------------------

### KETTENSCHALTUNG (Waben verbinden)

# BEISPIEL: HAUPTWABE → STARTWABE → ENDWABE
AXIOM ¡ HT + ⌬ + ST + ⌬ + ED ⑅ ː

# BEDEUTET:
# HAUPTWABE → STARTWABE → ENDWABE = PFAD
# → Die Waben sind verkettet

# BEISPIEL: BION-ID-KETTE
AXIOM ¡ ⠂ + ⠄ + ⌬ + ⠂ + ⠄ + ⌬ + ⠂ + ⠄ ⑅ ⠈

# BEDEUTET:
# NAME+NR → NAME+NR → NAME+NR = ENDE
# → Die BION-ID-Kette ist komplett

